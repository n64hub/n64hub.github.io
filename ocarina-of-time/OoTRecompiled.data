ransform="translate(232 72) rotate(48)"><path d="M0 0C-8.7 -7.8 -8 -21.6 0 -30 C8 -21.6 8.7 -7.8 0 0Z" fill="url(#u87-leaf)" stroke="#1d4426" stroke-width=".9"/><path d="M0 -1.8Q1.2 -15 0 -27" fill="none" stroke="#b9e6a0" stroke-opacity=".75" stroke-width="1.1" stroke-linecap="round"/><path d="M-4.7 -9Q-6.1 -18 -1.3 -26.5" fill="none" stroke="#e4ffd0" stroke-opacity=".35" stroke-width="1.4" stroke-linecap="round"/></g><g transform="translate(234 92) rotate(82)"><path d="M0 0C-10.4 -9.4 -9.6 -25.9 0 -36 C9.6 -25.9 10.4 -9.4 0 0Z" fill="url(#u87-leaf)" stroke="#1d4426" stroke-width=".9"/><path d="M0 -2.2Q1.4 -18 0 -32.4" fill="none" stroke="#b9e6a0" stroke-opacity=".75" stroke-width="1.1" stroke-linecap="round"/><path d="M-5.7 -10.8Q-7.3 -21.6 -1.5 -31.8" fill="none" stroke="#e4ffd0" stroke-opacity=".35" stroke-width="1.4" stroke-linecap="round"/></g><g transform="translate(226 112) rotate(116)"><path d="M0 0C-8.7 -7.8 -8 -21.6 0 -30 C8 -21.6 8.7 -7.8 0 0Z" fill="url(#u87-leaf)" stroke="#1d4426" stroke-width=".9"/><path d="M0 -1.8Q1.2 -15 0 -27" fill="none" stroke="#b9e6a0" stroke-opacity=".75" stroke-width="1.1" stroke-linecap="round"/><path d="M-4.7 -9Q-6.1 -18 -1.3 -26.5" fill="none" stroke="#e4ffd0" stroke-opacity=".35" stroke-width="1.4" stroke-linecap="round"/></g>
<path d="M62 46 L222 46 Q238 46 235.5 61.5 L225 122 Q222.5 136 208 136 L76 136 Q61.5 136 59 122 L48.5 61.5 Q46 46 62 46Z" fill="#000" opacity=".38" transform="translate(2 5)"/>
<path d="M62 46 L222 46 Q238 46 235.5 61.5 L225 122 Q222.5 136 208 136 L76 136 Q61.5 136 59 122 L48.5 61.5 Q46 46 62 46Z" fill="url(#u87-rim)"/>
<path d="M62 46 L222 46 Q238 46 235.5 61.5 L225 122 Q222.5 136 208 136 L76 136 Q61.5 136 59 122 L48.5 61.5 Q46 46 62 46Z" fill="url(#u87-goldIn)" transform="translate(142 91) scale(0.953 0.91) translate(-142 -91)"/>
<path d="M62 46 L222 46 Q238 46 235.5 61.5 L225 122 Q222.5 136 208 136 L76 136 Q61.5 136 59 122 L48.5 61.5 Q46 46 62 46Z" fill="#3d2c06" opacity=".7" transform="translate(142 91) scale(0.913 0.833) translate(-142 -91)"/>
<path d="M62 46 L222 46 Q238 46 235.5 61.5 L225 122 Q222.5 136 208 136 L76 136 Q61.5 136 59 122 L48.5 61.5 Q46 46 62 46Z" fill="url(#u87-disc)" transform="translate(142 91) scale(0.896 0.8) translate(-142 -91)"/>
