  <g><path d="M644.2 327.3 Q635.7 321.4 628.3 317.4 Q637 319.4 646 324.6Z" fill="url(#gs77)"/><path d="M647.7 325.4 Q651 317.9 655.8 312.6 Q653.1 318.7 650.5 326.5Z" fill="url(#gs78)"/><path d="M644.6 327 Q637.2 318.8 630.2 313.4 Q638.8 317.3 646.7 324.9Z" fill="url(#gs79)"/><path d="M646.3 325.3 Q649.8 315.2 655.7 308 Q653 316.1 650.7 326.6Z" fill="url(#gs80)"/><path d="M644.4 327.2 Q638.1 316.9 633.4 308.3 Q640.9 315.1 648 324.7Z" fill="url(#gs81)"/><path d="M646.7 325.9 Q647.6 310.8 649.7 298.5 Q649.5 310.9 649.2 326Z" fill="url(#gs82)"/><path d="M644.8 326.6 Q641.8 315.3 640.7 305.6 Q644.8 314.4 648.8 325.3Z" fill="url(#gs83)"/><path d="M645.9 326.1 Q644.3 309.3 645.3 295.3 Q646.5 309 648.8 325.8Z" fill="url(#gs84)"/><path d="M647 311.6 L647.1 326 L650.5 339.8" fill="none" stroke="#070a0b" stroke-width="2.4" stroke-linejoin="round"/><ellipse cx="647.1" cy="326.5" rx="3.2" ry="2" fill="#070a0b"/></g>
</svg>
<rml>
<head>
    <title>Browse</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="controls.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="frame">
        <div class="case window">

            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title">Choose your ROM</div>
                </div>
                <div class="chrome">
                    <div class="win-btn" id="win-min"><svg class="win-ic" src="../icons/minus.svg"/></div>
                    <div class="win-btn" id="win-max"><svg class="win-ic" src="../icons/square.svg"/></div>
                    <div class="win-btn" id="win-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                </div>
            </div>

            <!-- The folder being shown, above the list (the user's note of 2026-09-19: it sat
                 in the foot and ran into the foot's text). -->
            <div class="path-line">
                <span class="name">Folder</span>
                <span class="datum" id="browse-path">Drives</span>
            </div>

            <!-- The rows are built at runtime from the drives, then a folder's folders and ROM
                 files (main/launch.cpp lists them; the shell fills the rows). -->
            <div class="rows long" id="browse-rows"></div>

            <!-- A path typed or pasted (a file:// URL will do), Enter taking it as the ROM; or
                 Browse, which opens the file picker and puts the chosen file here. -->
            <div class="entry-line">
                <span class="name">Path</span>
                <input type="text" id="browse-input" class="path-input"/>
                <div class="btn" id="browse-pick">Browse</div>
            </div>

            <div class="foot">
                <span id="browse-foot">Enter opens a folder or takes a ROM, B goes up, or drop the file here</span>
            </div>

        </div>
    </div>
</body>
</rml>
/* The case: our chrome, built entirely from tokens.
 *
 * Read tokens.rcss first. Nothing below may contain a literal color, size, spacing, radius or
 * duration, and that is checked rather than trusted: tools/check_tokens.py fails the build if one
 * appears here.
 *
 * The composition is the decision's. A dark translucent case lit from the top left, regions
 * divided by hardware rather than by flat edges, and one moment: the focused row's brass edge
 * sitting proud of the panel face, catching the lamplight.
 */

body
{
	font-family: var(--font-body);
	font-weight: var(--weight-body);
	font-size: var(--size-row);
	color: var(--color-ink);
	width: 100%;
	height: 100%;
}

/* The scrim is what makes the case readable over a bright scene without hiding it. Deliberately
 * not opaque: the decision is explicitly about the backdrop reading THROUGH the case. */
.scrim
{
	width: 100%;
	height: 100%;
	background-color: var(--color-scrim);
	display: flex;
	align-items: center;
	justify-content: center;
}

/* THE PANEL ON THE RIGHT (2026-09-24, the user: "the panel option to affix to the right side of
 * the screen like planned before"). The same case, stood against the window's right edge for the
 * window's full height with no scrim over the picture, so a lighting control can be changed while
 * watching what it does. The shell puts the class on the scrim when the Menu placement row says
 * so; everything inside the case is unchanged. */
.scrim.side
{
	background-color: transparent;
	justify-content: flex-end;
	align-items: stretch;
}

.scrim.side .case
{
	max-height: 100%;
	height: 100%;
	border-radius: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	border-right-width: 0;
}

/* The same panel against the LEFT edge (the user, 2026-09-24): the edge on the window has no
 * rule, the edge on the picture keeps it. */
.scrim.side.left
{
	justify-content: flex-start;
}

.scrim.side.left .case
{
	border-left-width: 0;
	border-right-width: var(--rule);
}

.case
{
	width: var(--panel-width);
	max-height: var(--case-max-height);
	padding: var(--space-4);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	decorator: vertical-gradient(var(--color-slate-raised) var(--color-slate));
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
}

/* The lid seam. One line, sitting under the title, which is what separates the head of the case
 * from its contents without a second panel. */
.lid
{
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding-bottom: var(--space-2);
	border-bottom: var(--rule) var(--color-line);
	margin-bottom: var(--space-2);
}

/* The head of the lid: the mark, then the title, on one line. */
.head
{
	display: flex;
	align-items: center;
}

.head .mark
{
	margin-right: var(--space-3);
}

.title
{
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-display);
	color: var(--color-ink);
}

.hint
{
	font-size: var(--size-label);
	color: var(--color-faint);
}

/* The frame rate counter (the user's ask of 2026-09-19): a small branded plate at the top right
 * of the picture, beside the game's own interface, below the band the title bar rides in. */
.counter
{
	position: absolute;
	/* The side gap from the window's top edge while the title bar is hidden; under the bar,
	 * by the same gap, while it shows (the shell sets the class from the bar's state). */
	top: var(--space-3);
	right: var(--space-3);
	transition: top var(--duration-fast) var(--ease);
	padding: var(--space-2) var(--space-3);
	border: var(--rule) var(--color-line);
	border-left: var(--edge-focus) var(--color-lime);
	border-radius: var(--radius);
	decorator: vertical-gradient(var(--color-slate-raised) var(--color-slate));
	display: flex;
	align-items: center;
	font-family: var(--font-mono);
	font-size: var(--size-label);
	color: var(--color-ink);
}

.counter.under-bar
{
	top: var(--plate-top-under-bar);
}

.counter .mark
{
	width: var(--mark-small-w);
	height: var(--mark-small-h);
	margin-right: var(--space-2);
}

.counter .counter-unit
{
	color: var(--color-faint);
	margin-left: var(--rule);
}

/* The ROM browser (the user's notes of 2026-09-19): the folder line above the list, and the
 * path line below it, a field where a path is typed or pasted (Enter takes it) beside the
 * button that opens the file picker. */
.path-line
{
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: var(--space-2) 0;
	font-size: var(--size-label);
	color: var(--color-dim);
}

.path-line .datum
{
	font-family: var(--font-mono);
	color: var(--color-ink);
}

.entry-line
{
	display: flex;
	align-items: center;
	margin-top: var(--space-2);
}

.entry-line .name
{
	font-size: var(--size-label);
	color: var(--color-dim);
	margin-right: var(--space-3);
}

input.path-input
{
	flex: 1;
	padding: var(--space-2) var(--space-3);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	background-color: var(--color-slate-deep);
	font-family: var(--font-mono);
	font-size: var(--size-label);
	color: var(--color-ink);
	caret-color: var(--color-lime);
}

input.path-input:focus
{
	border-color: var(--color-lime);
}

.btn
{
	margin-left: var(--space-3);
	padding: var(--space-2) var(--space-3);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	color: var(--color-dim);
	cursor: pointer;
}

.btn:hover
{
	color: var(--color-ink);
	border-color: var(--color-lime);
	background-color: var(--color-accent-wash);
}

/* A modal's lid stacks (the user's asks of 2026-09-19): the mark, the title and the close
 * button on the first line (the launcher's own X, from window.rcss), the hint on its own line
 * beneath them, so a long hint never runs into the title. The launcher's lid keeps one line. */
.lid.stacked
{
	flex-direction: column;
	align-items: stretch;
}

.lid-top
{
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.lid.stacked .hint
{
	display: block;
	margin-top: var(--rule);
}

/* The rows. A track behind them so the case reads as a compartment with things set into it,
 * which is the whole conceit of the direction. */
.rows
{
	background-color: var(--color-slate-deep);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	padding: var(--rule);
	display: flex;
	flex-direction: column;
}

.row
{
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--space-2) var(--space-3);
	border-left: var(--edge-focus) transparent;
	transition: background-color var(--duration-fast) var(--ease),
	            border-left-color var(--duration-fast) var(--ease);
}

/* The pointer over a row, now that the mouse reaches the documents: the track's lift without
 * the edge, so the focused row stays the one moment. */
.row:hover
{
	background-color: var(--color-accent-wash);
}

/* THE ONE MOMENT. The focused row lifts out of the track and its left edge takes the light. It
 * is the only place the accent appears, which is what keeps it meaning something. */
.row.on
{
	background-color: var(--color-accent-wash);
	border-left: var(--edge-focus) var(--color-lime);
}

.row .label
{
	color: var(--color-dim);
	/* A LABEL IS NEVER SQUEEZED (the user, 2026-10-09, of the HUD row in the panel: "description
	 * crushes it"): a long value or action text folds onto more lines rather than pressing the
	 * label narrower, and keeps a gap from it. */
	flex-shrink: 0;
	margin-right: var(--space-3);
}

.row.on .label
{
	color: var(--color-ink);
}

.row .value
{
	font-family: var(--font-mono);
	color: var(--color-dim);
}

.row.on .value
{
	color: var(--color-lime);
}

/* An action row's value (Controls, Play, Quit) says nothing at rest; the text shows while
 * the row is focused or under the pointer (the user's note of 2026-09-19). */
.row .value .act
{
	display: none;
}

/* A DIVIDER INSIDE A LIST: a rule and a small name, where one part of the list ends and the next
 * begins, never a row (nothing focuses it). The Moments list's "Your slots", and the controls
 * screen's Photo mode section (the user, 2026-10-09: "a dedicated section within the controls
 * panel, like after a divider"), which can carry a badge beside its name. */
.divider
{
	display: flex;
	align-items: center;
	margin-top: var(--space-2);
	padding: var(--space-2) var(--space-3) var(--space-3);
	border-top: var(--rule) var(--color-line);
}

.divider-label
{
	font-size: var(--size-label);
	color: var(--color-faint);
	text-transform: uppercase;
	letter-spacing: var(--divider-tracking);
}

/* WHAT THE CHOICE MEANS, under the row (the user, 2026-10-09: "a description underneath them when
 * they're toggled that says what they do"). The row wraps so the note takes a line of its own
 * under the label and the value, the full width of the row, in the caption's size and the quiet
 * color; it is rebuilt with the row, so it changes as the choice does. */
.row.noted
{
	flex-wrap: wrap;
}

.row .row-note
{
	flex: 0 0 100%;
	margin-top: var(--space-2);
	font-size: var(--size-label);
	color: var(--color-faint);
}

.row.on .row-note
{
	color: var(--color-dim);
}

.row.on .value .act,
.row:hover .value .act
{
	display: inline;
}

/* The foot of the case. Provenance lives here on the about screen, and the controls hint on the
 * settings screen. */
.foot
{
	margin-top: var(--space-2);
	padding-top: var(--space-2);
	border-top: var(--rule) var(--color-line);
	display: flex;
	justify-content: space-between;
	column-gap: var(--space-4);
	font-size: var(--size-label);
	color: var(--color-faint);
}

/* A FOOT OF TWO IN THE PANEL IS STACKED (the user, 2026-10-09, of the lighting menu in the panel:
 * "this text ... needs to be stacked as well ... it's crushing them together"). The panel is too
 * narrow for the two side by side, so the second ran into the first with no space between; one
 * above the other, each has the panel's width. Over the picture they stay side by side, held
 * apart by the column gap above. */
.scrim.side .foot
{
	flex-direction: column;
	justify-content: flex-start;
	row-gap: var(--space-2);
}

/* About, which is a reading surface rather than a control surface, so it gets prose spacing and
 * no focus treatment at all. */
.prose
{
	display: block;
	color: var(--color-dim);
	font-size: var(--size-note);
	margin-bottom: var(--space-2);
}

.field
{
	display: flex;
	justify-content: space-between;
	padding: var(--space-2) 0;
	border-bottom: var(--rule) var(--color-line);
}

.field .name
{
	color: var(--color-dim);
}

.field .datum
{
	font-family: var(--font-mono);
	font-size: var(--size-label);
	color: var(--color-ink);
}

.heading
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-heading);
	color: var(--color-ink);
	margin-top: var(--space-2);
	margin-bottom: var(--space-2);
}

/* A scrolling region: About's body (the signature and the changelog made it longer than any
 * window), the controls list, the browser. Its height is set by the shell from the window's,
 * because a percentage of a case that is itself sized by its contents resolves to nothing. The
 * scrollbar rules serve every document that scrolls. */
.body
{
	overflow-y: auto;
	/* Room between the text and the bar at the right, and the same at the left, so the
	 * scrolling region reads as a compartment rather than text pressed against a rail. */
	padding-left: var(--space-3);
	padding-right: var(--space-4);
	box-sizing: border-box;
}

scrollbarvertical
{
	width: var(--scroll);
	background-color: var(--color-slate-deep);
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc
{
	height: 0;
}

scrollbarvertical slidertrack
{
	background-color: var(--color-slate-deep);
}

scrollbarvertical sliderbar
{
	background-color: var(--color-line);
	border-radius: var(--radius);
}

/* A second line under the foot: the launcher's signature line, a click target that opens
 * About (the user's ask of 2026-09-19). */
.foot-more
{
	padding-top: var(--space-2);
	display: flex;
	justify-content: space-between;
	font-size: var(--size-label);
	color: var(--color-faint);
}

.link
{
	color: var(--color-dim);
	cursor: pointer;
}

.link:hover
{
	color: var(--color-lime);
}

/* The changelog, newest version first: a version and its date on one line, the title, the
 * summary, then each section's label and its one-line changes. */
.entry
{
	display: block;
	padding: var(--space-2) 0;
	border-bottom: var(--rule) var(--color-line);
}

.entry-head
{
	display: flex;
	justify-content: space-between;
}

.entry-version
{
	font-family: var(--font-mono);
	color: var(--color-lime);
}

.entry-date
{
	font-family: var(--font-mono);
	font-size: var(--size-label);
	color: var(--color-faint);
}

.entry-title
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	color: var(--color-ink);
}

.entry-summary
{
	display: block;
	color: var(--color-dim);
	font-size: var(--size-note);
}

.entry-section
{
	display: block;
	color: var(--color-ink);
	font-size: var(--size-label);
	margin-top: var(--space-2);
}

.entry-item
{
	display: block;
	color: var(--color-dim);
	font-size: var(--size-note);
	padding-left: var(--space-3);
}

/* THE ACTIONS. Play and Quit are not settings and the user asked twice for them to stop looking
 * like settings: out of the list, under their own divider, Quit on the left as a secondary and
 * Play on the right as the primary. A row of the list says "here is a value you can change"; a
 * button says "this will happen", and the two should never wear the same clothes.
 *
 * They keep their place in the keyboard and pad order, so .on still marks the focused one. The
 * focus treatment is the list's own, which is what keeps one vocabulary across the screen. */
.actions
{
	margin-top: var(--space-2);
	padding-top: var(--space-2);
	border-top: var(--rule) var(--color-line);
	display: flex;
	align-items: center;
}

/* Half each, side by side. They were space-between, which threw them to opposite edges of a
 * 660 wide case with a third of the width of nothing between two controls that belong together
 * (the user, 2026-09-20: "we don't want them to be spaced between like this, it looks really
 * odd"). The gap is the only thing separating them now, which is what pairs them.
 *
 * THE SPACE BETWEEN THEM IS THE SPACE ABOVE THEM, which is `--pad-row`: the bar's own padding-top,
 * the distance from the rule to the top of the buttons (the user, 2026-09-20: "they should have
 * the same amount of gap between the buttons themselves and the border above them"). One token in
 * both places, so they cannot drift apart.
 *
 * This read `var(--rule)` and looked correct, which is why it survived a review: `--gap` is a ONE
 * dp hairline for a divider, not a step on the spacing scale, so the two buttons were a pixel
 * apart and touching to the eye. */
.actions .act-btn
{
	flex: 1 1 0;
	margin-right: var(--space-2);
}

.actions .act-btn:last-child
{
	margin-right: 0;
}

/* TWO TO A ROW (the user, 2026-10-09, of the Moments buttons in the panel: "These buttons are being
 * crushed. Maybe we should do 50-50 and then do two rows of buttons"). Four buttons side by side
 * left each a quarter of the case and folded a label onto three lines. Each now takes half, and
 * the third and fourth go to a second row; one left alone in a row takes the row. The space
 * between them, either way, is the space above them, as for the pair above. */
.actions.pairs
{
	flex-wrap: wrap;
	gap: var(--space-2);
}

.actions.pairs .act-btn
{
	flex: 1 1 40%;
	margin-right: 0;
}

.act-btn
{
	position: relative;
	display: flex;
	align-items: center;
	justify-content: center;
	min-height: var(--act-height);
	padding: 0 var(--pad-act-side);
	border-radius: var(--radius);
	border: var(--rule) var(--color-line);
	transition: background-color var(--duration-fast) var(--ease),
	            border-color var(--duration-fast) var(--ease);
}

/* Quit is the quiet one: it is always available and almost never what you came for. */
.act-quit
{
	background-color: transparent;
	color: var(--color-dim);
}

.act-quit:hover
{
	color: var(--color-ink);
	border-color: var(--color-faint);
}

/* Play is the one moment on this screen, which is why it carries the brass. */
.act-play
{
	background-color: var(--color-lime);
	border-color: var(--color-lime);
	color: var(--color-on-lime);
}

/* Under the pointer the lime brightens, as the website's primary button does (the user, 2026-10-13:
 * "mouse hover styles still show gold bg on primary button rather than lime"). */
.act-play:hover
{
	background-color: var(--color-lime-bright);
	border-color: var(--color-lime-bright);
}

/* FOCUSED, BY KEYBOARD OR PAD: A RING A FEW DP OUTSIDE THE BUTTON, the button keeping its own
 * fill (the user, 2026-10-13: "I don't like that the button is gold when it's the focused button.
 * I would rather maybe add an outline that's ... a couple pixels out from the edge of the button").
 * RmlUi has no outline and our renderer draws no box-shadow, so the ring is an element of its own,
 * added to every action button by the program as the documents load (ui_shell.cpp). */
.act-btn .focus-ring
{
	display: none;
	position: absolute;
	left: var(--focus-ring-out);
	top: var(--focus-ring-out);
	right: var(--focus-ring-out);
	bottom: var(--focus-ring-out);
	border: var(--focus-ring-width) var(--color-lime);
	pointer-events: none;
}

.act-btn.on .focus-ring
{
	display: block;
}

.act-label
{
	font-size: var(--size-row);
	font-weight: 600;
}

/* THE TWO STEPS EITHER SIDE OF A SETTING'S VALUE.
 * A click used to move a setting one way only, and a choice stops at its ends on purpose, so the
 * last option was a dead end for anyone using the mouse. The keys had always worked, and that was
 * the other half of it: nothing on screen said a setting had a back. These do what Left and Right
 * do, and they say so by being there.
 *
 * Quiet until the row is the one you are on, so twelve rows do not turn into twenty four arrows. */
.row .value .step
{
	display: inline-block;
	color: var(--color-faint);
	min-width: var(--step-width);
	text-align: center;
	padding: var(--space-2) 0;
	transition: color var(--duration-fast) var(--ease);
}

.row.on .value .step,
.row:hover .value .step
{
	color: var(--color-lime);
}

/* A step that cannot go anywhere is drawn spent rather than removed, so the row keeps its shape
 * as it is walked and the eye is not asked to re-find the value. */
.row .value .step.spent
{
	color: var(--color-line);
}

.row.on .value .step.spent,
.row:hover .value .step.spent
{
	color: var(--color-faint);
}

/* The value keeps one width whatever it reads, so the two chevrons hold still while a row is
 * stepped rather than sliding in and out under the pointer. Inline-block because a bare inline
 * box ignores a width. */
.row .value .shown
{
	display: inline-block;
	min-width: var(--value-width);
	text-align: right;
}

/* A ROW TO TICK (the user, 2026-10-09, of what brings the HUD back: "all separate options as just
 * checkbox toggles"). A box where a stepper's value sits, its right edge where the values' is (the
 * gap after it is a chevron's width), and a filled square inside it while the row is on. Quiet at
 * rest like the chevrons; the accent only on the row you are on. */
.row .value .check
{
	display: inline-block;
	width: var(--check);
	height: var(--check);
	border: var(--rule) var(--color-faint);
	border-radius: var(--radius);
	vertical-align: middle;
}

.row .value .check .tick
{
	display: none;
	margin: var(--check-inset);
	height: var(--check-tick);
	background-color: var(--color-dim);
	border-radius: var(--radius);
}

.row .value .check.ticked .tick
{
	display: block;
}

.row.on .value .check,
.row:hover .value .check
{
	border-color: var(--color-lime);
}

.row.on .value .check .tick,
.row:hover .value .check .tick
{
	background-color: var(--color-lime);
}

.row .value .step-gap
{
	display: inline-block;
	width: var(--step-width);
}

/* A destructive action, on the surface that can remove everything this program installed. It takes
 * the judgment color rather than the accent, because the accent means "this is the thing to do"
 * and removing your own install is emphatically not that. Outlined at rest and only filled once it
 * is the confirmation, so the first press of it never looks like the last one. */
.act-danger
{
	background-color: transparent;
	border-color: var(--color-error);
	color: var(--color-error);
}

.act-danger:hover
{
	background-color: var(--color-error);
	color: var(--color-on-lime);
}

.act-danger.armed
{
	background-color: var(--color-error);
	border-color: var(--color-error);
	color: var(--color-on-lime);
}

/* The path rows on the files surface. A path is long and a label is short, so the value takes the
 * room and truncates from the left, where the interesting end of a path is not. */
#files-rows .row .value
{
	font-size: var(--size-label);
	color: var(--color-dim);
}

#files-rows .row.on .value
{
	color: var(--color-lime);
}

/* A path is long and a label is short, so the label keeps its own column and the path takes the
 * rest of the line. The path is shortened from the FRONT in code before it gets here, so it is
 * always one line: wrapped, it pushed the label out of line with it and the two collided. */
#files-rows .row .label
{
	width: var(--files-label-width);
	flex: 0 0 auto;
}

#files-rows .row .value
{
	white-space: nowrap;
	flex: 1 1 auto;
}

/* Open, at the end of every files row: written on the row rather than guessed, shown while the
 * row is under the pointer or has the focus, in the brass because it is the thing to do there. */
#files-rows .row .open
{
	display: none;
	flex: 0 0 auto;
	margin-left: var(--space-3);
	font-size: var(--size-label);
	font-weight: 600;
	color: var(--color-lime);
}

#files-rows .row.on .open,
#files-rows .row:hover .open
{
	display: inline;
}

/* The two buttons under the files rows show the pointer and the focus alike (the user,
 * 2026-09-24: "the buttons for delete and back need focus and hover styles"): the quiet one
 * lifts to the lit row's ground with the brass edge, the destructive one fills with its own
 * judgment color. The focus arrives by the pad or the keyboard (the `on` class the shell sets)
 * or by the tab key (the `:focus` state), and both read the same. */
.act-quit:hover,
.act-quit:focus,
.act-quit.on
{
	color: var(--color-ink);
	border-color: var(--color-lime);
	background-color: var(--color-accent-wash);
}

.act-danger:focus,
.act-danger.on
{
	background-color: var(--color-error);
	border-color: var(--color-error);
	color: var(--color-on-lime);
}

/* Armed, the destructive button is the question itself: filled, and its edge lit in the brass so
 * it cannot be mistaken for the first press. */
.act-danger.armed,
.act-danger.armed:hover,
.act-danger.armed.on
{
	background-color: var(--color-error);
	border-color: var(--color-gold-bright);
	color: var(--color-on-lime);
}

/* The first run questions. A reading surface with two answers, so it gets prose spacing rather
 * than the rows' density, and the question itself carries the weight the rows' labels do not. */
.ask-body
{
	background-color: var(--color-slate-deep);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	padding: var(--space-4);
	display: block;
}

.ask-q
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-display);
	color: var(--color-ink);
	margin-bottom: var(--space-2);
}

/* The frame recorder's plate (the user's ask of 2026-09-22): the counter's plate in the opposite
 * corner. It takes .counter for the whole look and changes only the side it sits on and the
 * things the counter has no use for: a state dot, and a cursor, because unlike the counter this
 * one is a button. */
.counter.recorder
{
	left: var(--space-3);
	right: auto;
	/* NO `top` HERE ON PURPOSE. It takes the counter's, and the `under-bar` class moves both of
	 * them together when the title bar appears (the user's ask of 2026-09-23, so the two sit
	 * level).
	 *
	 * This rule DID pin the plate low for a day, and the pin outlived the C++ that was supposed to
	 * put the movement back: the class was being set and unset correctly while this line quietly
	 * won, so the plate never moved and only its low position could ever be clicked. The user
	 * spotted it from the behavior ("the low position is the only one working... because the
	 * plate never slides up") while the tests here were reporting the high position as a focus
	 * problem. A stylesheet that overrides the thing the code is toggling is invisible from the
	 * code's side.
	 *
	 * What makes a MOVING plate safe to click is not CSS but note_pointer in ui_shell.cpp: the
	 * bar's state is frozen while the pointer is on the plate, so it cannot slide away from a
	 * click on its way to it. */
	/* The lit edge goes on the outside edge of the plate, which is the left for the counter and
	 * the right for this one, so the two read as a mirrored pair rather than as two of the same
	 * thing that happen to be in different corners. */
	border-left: var(--rule) var(--color-line);
	border-right: var(--edge-focus) var(--color-lime);
	cursor: pointer;
}

/* While a recording runs the whole plate takes the record color on its outside edge, so the fact
 * that frames are being written is visible without reading anything. */
.counter.recorder.on
{
	border-right-color: var(--color-error);
}

/* Between the word and the time, so it divides them as well as saying what state the recorder is
 * in. A margin on BOTH sides now: with it only on the right, `Record` and `0:05` sat against each
 * other with nothing between them. */
.counter.recorder .dot
{
	width: var(--dot);
	height: var(--dot);
	border-radius: var(--dot);
	background-color: var(--color-faint);
	margin-left: var(--space-2);
	margin-right: var(--space-2);
	transition: background-color var(--duration-fast) var(--ease);
}

/* The dot already provides the gap on this side. */
.counter.recorder .counter-unit
{
	margin-left: 0;
}

.counter.recorder.on .dot
{
	background-color: var(--color-error);
}

/* Draining: the frames are taken and the encoders are catching up. The dot goes to the accent
 * rather than staying red, because nothing is being captured any more and a red dot would say
 * otherwise. */
.counter.recorder.saving .dot
{
	background-color: var(--color-lime);
}

/* A write failed. The one place the plate uses the fault color, and it stays until the next
 * recording starts. */
.counter.recorder.failed .dot
{
	background-color: var(--color-error);
}

/* THE ALWAYS ON OVERLAYS MUST NOT SWALLOW CLICKS, and until 2026-09-22 they did.
 *
 * Every document's body fills the whole context, so a document that is merely SHOWN covers the
 * picture for the purposes of hit testing even when the only thing it draws is a small plate in a
 * corner. Documents are stacked in the order they were last shown, so whichever overlay came up
 * last quietly took every click on the screen. The frame recorder's plate was drawn, lit, and
 * completely dead: the click was landing on the frame document's body, one layer above it.
 *
 * So the four overlays that are up while the game runs let clicks through by default, and the
 * parts of them that ARE buttons ask for them back. The modal documents are deliberately not in
 * this set: their scrim is supposed to take the click, which is what makes them modal. */
body.overlay
{
	pointer-events: none;
}

.counter.recorder,
.frame-bar
{
	pointer-events: auto;
}

/* ANY ROW LIST THAT CAN OUTGROW ITS CASE. Four documents use this: the controls, the debug menu,
 * the settings and the launcher. The shell caps the height from the window's own height, because
 * a percentage of a case that is itself sized by its contents resolves to nothing, and a fixed
 * height would be wrong for every window but one.
 *
 * It is a CAP rather than a height, so a short list is its own height and only a list that would
 * overflow the case scrolls. A fixed height leaves a tall empty box under a list of two. */
/* AS A SIDE PANEL THE LIST FILLS THE WINDOW (2026-09-24, the user: "fixed left or right menu
 * should expand scrollable area to allow fixed footer and fixed header to both be at top and
 * bottom of the windows height"). The case is already the window's full height there, so the
 * list takes every pixel between the lid and the actions instead of a share of the window, and
 * the head and the foot sit at the top and the bottom with the rows scrolling between them.
 * The shell stops setting its own cap in this placement, or the cap would win over this. */
.scrim.side .case .rows.long,
.scrim.side .case .body
{
	flex: 1 1 auto;
	min-height: 0;
	max-height: none;
}

.rows.long
{
	overflow-y: auto;
}

/* The update plate (the user's ask of 2026-09-23): the counter's plate at the BOTTOM left, where
 * it is under neither corner plate and never under the title bar, so it takes no `under-bar`
 * class. It shows only while there is news: the newer version being fetched, the fetched file
 * waiting for the next start, or a refused download. Like the recorder it is a button: a click
 * while the file is ready installs it now and closes this copy. */
.counter.update
{
	top: auto;
	bottom: var(--space-3);
	left: var(--space-3);
	right: auto;
	border-left: var(--rule) var(--color-line);
	border-right: var(--edge-focus) var(--color-lime);
	cursor: pointer;
}

/* The Moments list (phase 77): a row carries a thumbnail before its words. The picture is the
 * recorder's 320 by 240 frame drawn at a quarter, in the same tight corner the plates use; an
 * empty slot shows the track's own color in the same box so the rows stay level. The label holds
 * two lines, the slot's name under the moment's. */
.row.mrow
{
	justify-content: flex-start;
}
.row.mrow .thumb
{
	width: var(--thumb-width);
	height: var(--thumb-height);
	margin-right: var(--space-3);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	decorator: none;
}
.row.mrow .thumb.empty
{
	background-color: var(--color-slate-deep);
}
.row.mrow .label
{
	display: block;
	flex: 1 1 auto;
}
.row.mrow .label .slot
{
	display: block;
	font-family: var(--font-mono);
	font-size: var(--size-label);
	color: var(--color-faint);
}
.row.mrow .value
{
	font-size: var(--size-label);
}

/* A PAGE IN THE SHELL (the menus plan, phase 96). The section's document is laid into the box the
 * shell leaves for its page (shell.rml, #sh-host; the shell sets this document's position and size
 * to it and puts the class on its body). The shell draws the head, the section's name, the dial
 * and the prompts, so the page drops its own lid, foot and scrim and keeps only what it holds; the
 * list fills the box and scrolls inside it. */
body.in-shell .scrim,
body.in-shell .frame
{
	display: block;
	width: 100%;
	height: 100%;
	background-color: transparent;
}

body.in-shell .case,
body.in-shell .case.window,
body.in-shell .scrim.side .case
{
	width: 100%;
	height: 100%;
	max-height: 100%;
	padding: 0;
	border-width: 0;
	decorator: none;
	background-color: transparent;
}

body.in-shell .lid,
body.in-shell .foot
{
	display: none;
}

body.in-shell .rows.long,
body.in-shell .case .body
{
	flex: 1 1 auto;
	min-height: 0;
	max-height: none;
}

/* THE PLATES (the menus plan, phase 100, the design decision's rows, C Medallion): in the shell
 * each row is a raised plate on the panel's ground with air between them, a ring at its left with
 * the row's glyph in it, the label in ink, and the value drawn by its kind: a short set side by
 * side with the one in force gold, or a tick per option with the one in force lit beside its words.
 * The focused plate takes the lime: its edge, its ring and its glyph, its ticks. */
body.in-shell .rows
{
	background-color: transparent;
	border-width: 0;
	padding: 0;
}

body.in-shell .row
{
	min-height: var(--plate-min-height);
	margin-bottom: var(--plate-gap);
	padding: var(--plate-pad-y) var(--plate-pad-x) var(--plate-pad-y) var(--space-4);
	background-color: var(--color-slate-raised);
	border-left: var(--edge-focus) transparent;
}

body.in-shell .row:hover
{
	background-color: var(--color-plate-on);
}

body.in-shell .row.on
{
	background-color: var(--color-plate-on);
	border-left-color: var(--color-lime);
}

body.in-shell .row .label
{
	flex: 1 1 auto;
	color: var(--color-ink);
}

body.in-shell .divider
{
	border-top-width: 0;
	margin-top: var(--space-2);
	padding-left: 0;
}

.row .mi
{
	display: flex;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
	width: var(--plate-ring);
	height: var(--plate-ring);
	margin-right: var(--space-4);
	border: var(--edge-lit) var(--color-gold);
	border-radius: var(--plate-ring);
}

/* The glyph is a decorator, not an svg element: a page is laid into the shell's box after it is
 * first laid out, and an svg element keeps drawing where it was laid out before the move (seen by
 * the harness as the rows' icons drawn round the dial, 2026-10-13). A decorator follows its
 * element. It draws in the icon's own white; the ring carries the focus's lime. */
.row .mi-ic
{
	width: var(--plate-glyph);
	height: var(--plate-glyph);
}

.row.on .mi
{
	border-color: var(--color-lime);
}

.row .value .choices
{
	display: inline-flex;
	vertical-align: middle;
	font-family: var(--font-mono);
	font-size: var(--size-note);
}

.row .value .pick
{
	padding: var(--space-2) var(--space-3);
	border: var(--rule) var(--color-line);
	color: var(--color-faint);
	margin-left: var(--plate-pick-join);
}

.row .value .pick:hover
{
	color: var(--color-ink);
	border-color: var(--color-faint);
}

.row .value .pick.in
{
	background-color: var(--color-gold);
	border-color: var(--color-gold);
	color: var(--color-on-gold);
}

.row .value .ticks
{
	display: inline-flex;
	vertical-align: middle;
	align-items: center;
	margin: 0 var(--space-2);
}

.row .value .tk
{
	width: var(--tick-width);
	height: var(--tick-height);
	margin-left: var(--tick-gap);
	background-color: var(--color-line);
}

.row .value .tk.in
{
	background-color: var(--color-gold);
}

.row.on .value .tk.in
{
	background-color: var(--color-lime);
}

body.in-shell .row .value .shown
{
	color: var(--color-gold);
}

body.in-shell .row.on .value .shown
{
	color: var(--color-ink);
}

/* AN ACTION ROW'S WORDS FOLD, AND NEVER COVER ITS NAME (the user, 2026-10-13, of the Debugging row in
 * the docked panel: "Everything starts to overlap"; its "Toggles for development, not for playing"
 * was drawn over "Debugging"). A value holds one line at its own width, so a long action text ran
 * left over the label once the panel was narrower than both. On an action row the label keeps its
 * width and the words take what is left, folding onto more lines at the right. */
body.in-shell .row.acting .label
{
	flex: 0 0 auto;
}

body.in-shell .row.acting .value
{
	flex: 1 1 auto;
	min-width: 0;
	white-space: normal;
	text-align: right;
}

/* A plate's value holds its parts on one line (the steps, the ticks, the words), at its own width.
 * Not a flex box: a value that is bare words (the controls' device, a path) would not be drawn in
 * one; the ticks and the choices are inline flex boxes inside it instead. */
body.in-shell .row .value
{
	white-space: nowrap;
	flex-shrink: 0;
}

/* A page that keeps its foot in the shell, for what it says (the controls' device). */
body.in-shell .foot.keep
{
	display: flex;
	border-top-width: 0;
}

body.in-shell .foot.keep .hide-in-shell
{
	display: none;
}

/* Your files in the shell: its list fills the page's box and scrolls in it, rather than running
 * past the box over the prompts; the open link keeps its own room after the path. */
body.in-shell #files-rows
{
	flex: 1 1 auto;
	min-height: 0;
	overflow-y: auto;
}

body.in-shell #files-rows .row .open
{
	margin-left: var(--space-3);
}

/* The ROM browser in the shell: a list of files, so its plates are slim and several show on the
 * launcher's short page; the list scrolls in the box between the folder line and the path. */
body.in-shell #browse-rows
{
	overflow-y: auto;
}

body.in-shell #browse-rows .row
{
	min-height: var(--plate-list-min-height);
	margin-bottom: var(--plate-list-gap);
	padding-top: var(--plate-list-pad-y);
	padding-bottom: var(--plate-list-pad-y);
}
/* The controls document: the case's rows with the two additions the plan names (a device row
 * whose value cycles, and a scanning state for the slot a capture is listening for) and the
 * capture panel from the decision's binding capture surface. Tokens only, as case.rcss;
 * tools/check_tokens.py holds this file to it too.
 */

/* The `.rows.long` rule moved to case.rcss on 2026-09-23, when the settings and launcher lists
 * became scrolling lists too. Four documents share it now, and only two of them link this file.
 * The scrollbar's rules were already there. */

/* A binding row's two slots, right aligned in fixed columns so the names line up down the
 * list. The picked slot in the focused row takes the accent and an underline, which is what
 * says left and right choose a slot. */
.slots
{
	display: flex;
	align-items: center;
}

.slot
{
	font-family: var(--font-mono);
	color: var(--color-dim);
	width: var(--slot-width);
	text-align: right;
	margin-left: var(--space-3);
	border-bottom: var(--rule) transparent;
	transition: color var(--duration-fast) var(--ease),
	            border-bottom-color var(--duration-fast) var(--ease);
}

.row.on .slot
{
	color: var(--color-ink);
}

.row.on .slot.pick
{
	color: var(--color-lime);
	border-bottom-color: var(--color-lime);
}

/* The column names, above the first binding row. The row sits in the list but is not one of the
 * rows: nothing selects it, so it takes no focus color and no hover. It exists because both
 * columns are live at once and the second read as a duplicate of the first without a name on it.
 *
 * NOT CALLED `heading`, and that is the whole story of a bug the user caught in 0.3.5. This file
 * links case.rcss, which already has a `.heading` for a section title, and it is `display:
 * block`. A row of `class="row heading"` therefore stopped being a flex row: the label and the
 * two columns stacked, so the names sat a couple of hundred pixels left of the values they
 * named. The columns themselves were always the right width and the right distance apart, which
 * is why it looked like an alignment bug rather than a display one. A class name in a shared
 * stylesheet is a shared name. */
.row.cols
{
	color: var(--color-dim);
	font-size: var(--size-label);
	border-bottom: var(--rule) var(--color-line);
}

.row.cols .slot
{
	color: var(--color-dim);
	font-family: var(--font-body);
	font-size: var(--size-label);
}

/* THE BADGE BESIDE A CONTROL THAT DOES NOTHING YET (2026-10-09): the settings row it needs, while
 * that row is Off (ui_controls.h, row_badge). A small plate in the caption's size, quiet, so it
 * reads as a note on the row rather than as part of the control's name. */
.badge
{
	margin-left: var(--space-2);
	padding: 0 var(--space-2);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	font-family: var(--font-body);
	font-size: var(--size-label);
	color: var(--color-faint);
}

.row.on .badge
{
	color: var(--color-dim);
	border-color: var(--color-faint);
}

/* A badged binding's name with its badge on a line of its own under it, never folded: beside the
 * name, "Needs Video recording on" broke in two in the panel's label column. On the section's
 * divider the badge stays beside the section's name, where there is room. */
.badge
{
	white-space: nowrap;
}

.label.badged
{
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}

.label.badged .badge
{
	margin-left: 0;
	margin-top: var(--badge-drop);
}

/* A binding that is bound, saved and currently ignored: the four C buttons on the right stick
 * while free aim holds that stick. Struck through rather than hidden, because it is still
 * there and comes back the moment free aim goes off. */
.slot.idle
{
	color: var(--color-dim);
	text-decoration: line-through;
}

.row.on .slot.idle
{
	color: var(--color-dim);
}

/* The line under the rows that says why. Empty most of the time, and then it takes no room. */
.notice
{
	color: var(--color-dim);
	font-size: var(--size-label);
	padding: var(--space-2) var(--space-3);
	border-top: var(--rule) var(--color-line);
}

.notice.gone
{
	display: none;
}

/* Scanning: the slot a capture is listening for, in the existing focus color with the
 * existing short transition. Nothing new is invented here. */
.row.scanning .slot.pick
{
	color: var(--color-lime);
	background-color: var(--color-accent-soft);
}

/* The capture panel, the decision's binding capture surface: a modal state over the rows with
 * no way out but a press or a cancel, and the countdown that makes the trap obvious. */
.capture
{
	display: none;
}

.capture.open
{
	display: flex;
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	background-color: var(--color-scrim);
}

.capture-case
{
	width: var(--capture-width);
	padding: var(--space-4);
	border: var(--rule) var(--color-faint);
	border-radius: var(--radius);
	decorator: vertical-gradient(var(--color-slate-raised) var(--color-slate));
	text-align: center;
}

/* THE THREE LINES STACK. RmlUi gives a div no display of its own, so without these the title,
 * the instruction and the countdown ran on as one line (the user, 2026-09-23: "it shouldn't be
 * all in a row like this. It should stack"). */
.capture .ctitle
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-heading);
	color: var(--color-dim);
	margin-bottom: var(--space-2);
}

.capture .big
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-display);
	color: var(--color-ink);
	margin-bottom: var(--space-2);
}

.capture .line
{
	display: block;
	margin-top: var(--space-2);
	padding-top: var(--space-2);
	border-top: var(--rule) var(--color-line);
	letter-spacing: var(--tracking-caption);
	font-family: var(--font-mono);
	font-size: var(--size-label);
	color: var(--color-faint);
}
<rml>
<head>
    <title>Controls</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="controls.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Controls</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                    </div>
                </div>
                <div class="hint">Up and down to move, left and right to pick a slot, Enter binds, Delete clears, Escape closes</div>
            </div>

            <!-- The rows are built at runtime from the device list and the live bindings
                 (src/ui/ui_controls.cpp): the device row, one row per game input with its two
                 slots, then the deadzone, rumble and reset rows. The document holds no names
                 of its own, so the order on screen is the order in the bindings file. -->
            <div class="rows long" id="controls-rows"></div>

            <!-- Why a binding on screen is not doing anything at the moment. Written at runtime
                 and empty the rest of the time, which the stylesheet takes as hidden. -->
            <div class="notice" id="controls-notice"></div>

            <div class="foot keep">
                <span id="controls-note">Keyboard</span>
                <span class="hide-in-shell" id="controls-foot">Saved as you change it. F3 closes this</span>
            </div>

        </div>
    </div>

    <!-- The capture: shown while a binding is being listened for, and for a moment after. -->
    <div class="capture" id="capture">
        <div class="capture-case">
            <div class="ctitle" id="capture-title">Rebind</div>
            <div class="big">Press any control</div>
            <div class="line" id="capture-line">Listening</div>
        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Counter</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
</head>
<body class="overlay">
    <!-- The frame rate counter (the user's ask of 2026-09-19): a small plate at the top right
         of the picture, beside the game's own interface, the frames presented per second. The
         shell fills the number twice a second and shows the document while the row is on. -->
    <div class="counter" id="counter">
        <div class="mark"></div>
        <span class="counter-value" id="counter-value">0</span>
        <span class="counter-unit">fps</span>
    </div>
</body>
</rml>
/* THE CUT (the menus plan, phase 88): the website's signature joint, carried into the menus as
 * the docked panel's slanted edge with its gold lit line (the Medallion direction,
 * .scaffold/menus/design/decision/). Not a shader: a linear gradient with hard stops. "to bottom
 * right" sets its middle line exactly from the edge element's top right corner to its bottom left,
 * so the slant follows the element's own box at any window height: the panel's ground up to the
 * line, the gold line along it, nothing beyond. The ramp behind it is 1024 texels, so the gold
 * stays within a pixel down a 1080 line window (src/ui/ui_gradient.h).
 *
 * .cut-edge sits against the panel's outer side, the panel's own ground carried into a wedge.
 * Docked right, .mirror turns it to face the picture on the left. */

.cut-edge
{
	position: absolute;
	top: 0;
	bottom: 0;
	right: 0;
	width: var(--cut-edge-width);
	decorator: linear-gradient(to bottom right, var(--cut-ground) 50%, var(--cut-light) 50%, var(--cut-light) 51.7%, transparent 51.7%);
	pointer-events: none;
}

.cut-edge.mirror
{
	right: auto;
	left: 0;
	decorator: linear-gradient(to bottom left, var(--cut-ground) 50%, var(--cut-light) 50%, var(--cut-light) 51.7%, transparent 51.7%);
}

/* The contour survey: our own drawing of the site's contour lines, at the size of the largest
 * panel (tools/generate_contours.py), laid under a panel's content and never over the picture. */
.survey
{
	position: absolute;
	left: 0;
	top: 0;
	width: var(--survey-width);
	height: var(--survey-height);
	decorator: svg(textures/contours.svg);
	pointer-events: none;
}
<rml>
<head>
    <title>Debugging</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="debug-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Debugging</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                    </div>
                </div>
                <div class="hint">For development, not for playing. Up and down to move, left and right to change, Escape or the pad's B goes back</div>
            </div>

            <!-- EVERYTHING MEANT FOR DEVELOPMENT RATHER THAN FOR PLAYING, in one place (the user,
                 2026-09-26). The rows are built by the shell from the same two models the other
                 menus use, picked out by key (is_debug_setting, is_debug_lighting in
                 ui_shell.cpp), so a row can never appear in both menus or in neither. The way in
                 is a confirmation, never this document directly. -->
            <div class="rows long" id="debug-rows" data-model="rows"></div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="debug-foot">Put anything you change back when you are done; none of this is needed to play</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Your files</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="frame">
        <div class="case window">

            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title">Your files</div>
                </div>
                <div class="chrome">
                    <div class="win-btn" id="win-min"><svg class="win-ic" src="../icons/minus.svg"/></div>
                    <div class="win-btn" id="win-max"><svg class="win-ic" src="../icons/square.svg"/></div>
                    <div class="win-btn" id="win-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                </div>
            </div>

            <!-- The answer to "where is this actually putting things", which is the objection to
                 putting somebody's files anywhere they did not choose. Every row shows the REAL
                 resolved path rather than what it is supposed to be, and opening a row opens that
                 folder in the file browser. The rows are filled by the shell. -->
            <div class="path-line">
                <span class="name">Running</span>
                <span class="datum" id="files-mode">portable</span>
            </div>

            <!-- Every row ends in Open, which appears when the row is under the pointer or has the
                 focus, so the way to open a folder is written on it rather than guessed (the user,
                 2026-09-24: "options to Open each directory"). The whole row opens it too. -->
            <div class="rows" id="files-rows">
                <div class="row" id="frow-0"><span class="label" id="flabel-0"></span><span class="value" id="fvalue-0"></span><span class="open" id="fopen-0">Open</span></div>
                <div class="row" id="frow-1"><span class="label" id="flabel-1"></span><span class="value" id="fvalue-1"></span><span class="open" id="fopen-1">Open</span></div>
                <div class="row" id="frow-2"><span class="label" id="flabel-2"></span><span class="value" id="fvalue-2"></span><span class="open" id="fopen-2">Open</span></div>
                <div class="row" id="frow-3"><span class="label" id="flabel-3"></span><span class="value" id="fvalue-3"></span><span class="open" id="fopen-3">Open</span></div>
                <div class="row" id="frow-4"><span class="label" id="flabel-4"></span><span class="value" id="fvalue-4"></span><span class="open" id="fopen-4">Open</span></div>
                <div class="row" id="frow-5"><span class="label" id="flabel-5"></span><span class="value" id="fvalue-5"></span><span class="open" id="fopen-5">Open</span></div>
                <div class="row" id="frow-6"><span class="label" id="flabel-6"></span><span class="value" id="fvalue-6"></span><span class="open" id="fopen-6">Open</span></div>
                <div class="row" id="frow-7"><span class="label" id="flabel-7"></span><span class="value" id="fvalue-7"></span><span class="open" id="fopen-7">Open</span></div>
                <div class="row" id="frow-8"><span class="label" id="flabel-8"></span><span class="value" id="fvalue-8"></span><span class="open" id="fopen-8">Open</span></div>
                <div class="row" id="frow-9"><span class="label" id="flabel-9"></span><span class="value" id="fvalue-9"></span><span class="open" id="fopen-9">Open</span></div>
                <div class="row" id="frow-10"><span class="label" id="flabel-10"></span><span class="value" id="fvalue-10"></span><span class="open" id="fopen-10">Open</span></div>
                <div class="row" id="frow-11"><span class="label" id="flabel-11"></span><span class="value" id="fvalue-11"></span><span class="open" id="fopen-11">Open</span></div>
            </div>

            <!-- Two states in one bar. At rest it is Close and Uninstall; once Uninstall has
                 been pressed the question in the foot changes and so do these, so a destructive
                 action is never one click away and never needs a second window. Both buttons
                 take the focus (the pad and the keyboard walk the rows and then the bar), and
                 both show it and the pointer over them. -->
            <div class="actions">
                <div class="act-btn act-quit" id="files-left" tabindex="auto"><span class="act-label" id="files-left-label">Close</span></div>
                <div class="act-btn act-danger" id="files-right" tabindex="auto"><span class="act-label" id="files-right-label">Uninstall</span></div>
            </div>

            <div class="foot">
                <span id="files-foot">Click a row, or its Open, to open that folder</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Frame</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body class="overlay">
    <!-- The game window's own frame (play milestone): a brass edge around the window, and the
         header, the launcher's lid, riding over the picture when the pointer is at the top of
         the window. The shell shows and hides the two; the window itself has no border of the
         system's. -->
    <div class="frame-edge hidden" id="frame-edge"></div>
    <div class="frame-bar hidden" id="frame-bar">
        <div class="head">
            <div class="mark"></div>
            <div class="title">OoT: Recompiled</div>
        </div>
        <div class="chrome">
            <div class="win-btn" id="win-min"><svg class="win-ic" src="../icons/minus.svg"/></div>
            <div class="win-btn" id="win-max"><svg class="win-ic" src="../icons/square.svg"/></div>
            <div class="win-btn" id="win-close"><svg class="win-ic" src="../icons/x.svg"/></div>
        </div>
    </div>
</body>
</rml>
/* The startup hint: the decision's toast, the one surface allowed over play. It sits in the
 * bottom left corner, takes no input, and goes on the first press or after five seconds (the
 * shell's clock; the fade is the slow duration). Tokens only, like every component sheet.
 */

body
{
	position: absolute;
	left: var(--space-4);
	bottom: var(--space-4);
	font-family: var(--font-body);
	font-weight: var(--weight-body);
	font-size: var(--size-note);
	color: var(--color-ink);
}

.toast
{
	display: flex;
	align-items: center;
	padding: var(--space-3);
	max-width: var(--toast-width);
	border: var(--rule) var(--color-line);
	border-radius: var(--radius);
	decorator: vertical-gradient(var(--color-slate-raised) var(--color-slate));
	opacity: 1;
	transition: opacity var(--duration-slow) var(--ease);
}

.toast.gone
{
	opacity: 0;
}

/* The mark beside the text (mark.rcss). It centers on the whole toast rather than on the first
 * line, as the decision's does. */
.toast .mark
{
	margin-right: var(--space-3);
}

.tx
{
	border-left: var(--rule) var(--color-line);
	padding-left: var(--space-3);
}

/* Two lines, one above the other. RmlUi lays a div out inline unless told otherwise, and the
 * first capture had both lines running on as one. */
.lead,
.note
{
	display: block;
}

.lead
{
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-heading);
	color: var(--color-ink);
}

.note
{
	font-size: var(--size-label);
	color: var(--color-dim);
}

/* A toast with nothing to add on a second line (a state was saved, a state was restored) is one
 * line, not one line and a gap where the second would have been. */
.note.gone
{
	display: none;
}
<rml>
<head>
    <title>Hint</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="hint.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
</head>
<body class="overlay">
    <!-- Both lines are filled at runtime from the live bindings (the keyboard's menu key, and
         the first pad's menu button when a pad is connected), so the text here is only what
         shows if the shell never gets to write it. -->
    <div class="toast" id="toast">
        <div class="mark"></div>
        <div class="tx">
            <div class="lead" id="hint-lead">F1 opens the menu</div>
            <div class="note" id="hint-note">Any time in play</div>
        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="hud-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">HUD</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                    </div>
                </div>
                <div class="hint">Up and down to move, left and right to change, Escape or the pad's B goes back</div>
            </div>

            <!-- THE GAME'S HUD, HOW IT FADES (the user, 2026-10-09: "auto-dim/auto-hide hud when not
                 in use ... dim at all times, or hide/dim hud on mapped key or button"). The rows are
                 the settings table's, picked out by key (is_hud_setting in ui_shell.cpp), each shown
                 only while it applies; src/game/hud.h has the rest. -->
            <div class="rows long" id="hud-rows" data-model="rows"></div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="hud-foot">The HUD button is on the controls screen, Tab or the right stick's click by default</span>
            </div>

        </div>
    </div>
</body>
</rml>
/* THE ON-SCREEN KEYBOARD (the menus plan, phase 110): a slate panel over the bottom of the window
 * with the line being typed above five rows of keys, the focused key lit lime. Tokens only. */

body.kb-doc
{
	width: 100%;
	height: 100%;
	font-family: var(--font-mono);
	font-size: var(--size-value);
	color: var(--color-ink);
	background-color: var(--color-scrim);
}

.kb
{
	position: absolute;
	left: 50%;
	bottom: var(--kb-bottom);
	width: var(--kb-width);
	transform: translateX(-50%);
	padding: var(--space-4);
	background-color: var(--color-slate);
	border: var(--rule) var(--color-line);
	border-top: var(--edge-lit) var(--color-gold);
}

.kb-line
{
	height: var(--kb-line-height);
	margin-bottom: var(--space-3);
	padding: 0 var(--space-3);
	display: flex;
	align-items: center;
	background-color: var(--color-slate-deep);
	border: var(--rule) var(--color-line);
	white-space: nowrap;
	overflow: hidden;
}

.kb-row
{
	display: flex;
	margin-bottom: var(--kb-key-gap);
}

.key
{
	flex: 1 1 0;
	height: var(--kb-key-height);
	margin-right: var(--kb-key-gap);
	display: flex;
	align-items: center;
	justify-content: center;
	background-color: var(--color-slate-raised);
	border: var(--rule) var(--color-line);
	transition: background-color var(--duration-fast) var(--ease);
}

.key:last-child
{
	margin-right: 0;
}

.key.wide
{
	flex: 2 1 0;
	font-family: var(--font-body);
	font-size: var(--size-note);
}

.key:hover
{
	background-color: var(--color-plate-on);
}

.key.is-f
{
	background-color: var(--color-plate-on);
	border-color: var(--color-lime);
	color: var(--color-lime);
}

.key.on
{
	color: var(--color-gold);
	border-color: var(--color-gold);
}
<rml>
<head>
    <title>Keyboard</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="keyboard.rcss"/>
</head>
<!-- THE ON-SCREEN KEYBOARD (the menus plan, phase 110): so a pad can type a path in the ROM
     browser. A layer over the menu: the layout engine moves among its keys by where they are
     (src/ui/nav/), and the navigation check checks it at every size. The keys are
     src/ui/keyboard/keyboard.cpp's rows, in its order; a key's id is its row and column there. -->
<body class="kb-doc">
    <div class="kb is-open" id="kb" data-nav="layer" data-back="close">
        <div class="kb-line"><span id="kb-line">|</span></div>
        <div class="kb-row" data-nav="group">
            <div class="key" id="key-0-0" data-act="type"><span>1</span></div><div class="key" id="key-0-1" data-act="type"><span>2</span></div><div class="key" id="key-0-2" data-act="type"><span>3</span></div><div class="key" id="key-0-3" data-act="type"><span>4</span></div><div class="key" id="key-0-4" data-act="type"><span>5</span></div><div class="key" id="key-0-5" data-act="type"><span>6</span></div><div class="key" id="key-0-6" data-act="type"><span>7</span></div><div class="key" id="key-0-7" data-act="type"><span>8</span></div><div class="key" id="key-0-8" data-act="type"><span>9</span></div><div class="key" id="key-0-9" data-act="type"><span>0</span></div><div class="key" id="key-0-10" data-act="type"><span>-</span></div><div class="key" id="key-0-11" data-act="type"><span>_</span></div>
        </div>
        <div class="kb-row" data-nav="group">
            <div class="key" id="key-1-0" data-act="type"><span>q</span></div><div class="key" id="key-1-1" data-act="type"><span>w</span></div><div class="key" id="key-1-2" data-act="type"><span>e</span></div><div class="key" id="key-1-3" data-act="type"><span>r</span></div><div class="key" id="key-1-4" data-act="type"><span>t</span></div><div class="key" id="key-1-5" data-act="type"><span>y</span></div><div class="key" id="key-1-6" data-act="type"><span>u</span></div><div class="key" id="key-1-7" data-act="type"><span>i</span></div><div class="key" id="key-1-8" data-act="type"><span>o</span></div><div class="key" id="key-1-9" data-act="type"><span>p</span></div><div class="key" id="key-1-10" data-act="type"><span>\</span></div><div class="key" id="key-1-11" data-act="type"><span>/</span></div>
        </div>
        <div class="kb-row" data-nav="group">
            <div class="key" id="key-2-0" data-act="type"><span>a</span></div><div class="key" id="key-2-1" data-act="type"><span>s</span></div><div class="key" id="key-2-2" data-act="type"><span>d</span></div><div class="key" id="key-2-3" data-act="type"><span>f</span></div><div class="key" id="key-2-4" data-act="type"><span>g</span></div><div class="key" id="key-2-5" data-act="type"><span>h</span></div><div class="key" id="key-2-6" data-act="type"><span>j</span></div><div class="key" id="key-2-7" data-act="type"><span>k</span></div><div class="key" id="key-2-8" data-act="type"><span>l</span></div><div class="key" id="key-2-9" data-act="type"><span>:</span></div><div class="key" id="key-2-10" data-act="type"><span>.</span></div><div class="key" id="key-2-11" data-act="type"><span>,</span></div>
        </div>
        <div class="kb-row" data-nav="group">
            <div class="key wide" id="key-3-0" data-act="type"><span>Shift</span></div><div class="key" id="key-3-1" data-act="type"><span>z</span></div><div class="key" id="key-3-2" data-act="type"><span>x</span></div><div class="key" id="key-3-3" data-act="type"><span>c</span></div><div class="key" id="key-3-4" data-act="type"><span>v</span></div><div class="key" id="key-3-5" data-act="type"><span>b</span></div><div class="key" id="key-3-6" data-act="type"><span>n</span></div><div class="key" id="key-3-7" data-act="type"><span>m</span></div><div class="key" id="key-3-8" data-act="type"><span>(</span></div><div class="key" id="key-3-9" data-act="type"><span>)</span></div><div class="key" id="key-3-10" data-act="type"><span>'</span></div><div class="key wide" id="key-3-11" data-act="type"><span>Backspace</span></div>
        </div>
        <div class="kb-row" data-nav="group">
            <div class="key wide" id="key-4-0" data-act="type"><span>Space</span></div><div class="key wide" id="key-4-1" data-act="type"><span>Done</span></div>
        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Launch</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="frame">
        <div class="case window">

            <!-- The lid is the window's title bar: the mark and the title, then our own
                 minimize and close. The band is draggable (main/launch.cpp's hit test). -->
            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title">OoT: Recompiled</div>
                </div>
                <div class="chrome">
                    <div class="win-btn" id="win-min"><svg class="win-ic" src="../icons/minus.svg"/></div>
                    <div class="win-btn" id="win-max"><svg class="win-ic" src="../icons/square.svg"/></div>
                    <div class="win-btn" id="win-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                </div>
            </div>

            <!-- THE ROWS ARE BUILT FROM THE MODEL, NOT LISTED HERE, exactly as the controls
                 document and the debug menu build theirs. This used to be a fixed run of row
                 elements, and on 2026-09-22 adding two settings pushed three rows off the end of
                 it: a row with no element simply does not appear, so Controls, Your files and
                 Debug vanished while the menu looked perfectly normal. Slots were added, and then
                 the user asked the better question ("but can we not just add scrollable areas?"),
                 which is this. There is now no number here to get wrong, and a list longer than
                 the case scrolls instead of being cut off. -->
            <div class="rows long" id="launch-rows" data-model="rows"></div>

            <!-- Play and Quit are ACTIONS, not settings, and the user asked twice for them to
                 look like it: out of the list, under a divider, Quit on the left as a secondary
                 and Play on the right as the primary. They keep their place in the keyboard and
                 pad order; only where they are drawn has changed. -->
            <div class="actions">
                <div class="act-btn act-quit" id="act-quit"><span class="act-label" id="act-quit-label">Quit</span></div>
                <div class="act-btn act-play" id="act-play"><span class="act-label" id="act-play-label">Play</span></div>
            </div>

            <!-- ONE foot row (the user, 2026-09-20: "it's just a single row"). The key hints
                 on the left; the version and what Windows says of this program's own file
                 together on the right, as one clickable thing that opens About. The ROM blurb
                 that used to sit left of the hints is gone: the ROM row already says it. -->
            <div class="foot">
                <span id="launch-foot">F2 is about, F3 is controls</span>
                <span class="link" id="launch-signed">Not signed</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Letterbox</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <style>
        /* THE BARS OF A Z TARGET AND A CUTSCENE (2026-09-24; the user: "the black bar at top and
           bottom of screen animates in very very chappy rather than smooth when z targeting").
           The game makes them by scissoring the picture, and that scissor can only move once per
           game update; these are drawn over the picture instead and their height is set every
           frame the program presents, so they slide rather than step.

           No transition and no animation here on purpose: the easing is done in the program, in
           the game's own units and at the game's own speed, so the bars arrive exactly when the
           game believes they have. A transition on top would fight it. */
        body {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        .bar {
            position: absolute;
            left: 0;
            width: 100%;
            height: 0px;
            background-color: var(--letterbox);
        }
        .bar.top { top: 0; }
        .bar.bottom { bottom: 0; }
    </style>
</head>
<body>
    <div class="bar top" id="letterbox-top"></div>
    <div class="bar bottom" id="letterbox-bottom"></div>
</body>
</rml>
<rml>
<head>
    <title>Lighting</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="lighting-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Lighting</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><svg class="win-ic" src="../icons/x.svg"/></div>
                    </div>
                </div>
                <div class="hint">Every change shows at once. Up and down to move, left and right to change, Escape or the pad's B goes back</div>
            </div>

            <!-- Built from the lighting model (ui_lighting.cpp), the way the settings rows are: one
                 row per control, each with an Off where off makes sense and a scale of levels, and
                 a Reset row at the end that puts the design's values back. -->
            <div class="rows long" id="lighting-rows" data-model="rows"></div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="lighting-foot">Each part switches on its own; the tools for inspecting a single pass are under Debugging</span>
            </div>

        </div>
    </div>
</body>
</rml>
/* The mark: three stacked triangles, ours, in the decision's brass, with the gleam crossing them
 * every few seconds exactly as the decision's snapshots draw it. It is drawn by the mark's pixel
 * shader (src/ui/shaders/ui.hlsl, PSMark) through RmlUi's shader decorator, because the shape is
 * a mask over a sliding gradient and the renderer draws masks in a shader or not at all. The box
 * is sized here; the shader fits and centers the mark inside it. Tokens only, as every component
 * sheet.
 *
 * Markup, in every lid and in the hint:
 *
 *     <div class="mark"></div>
 */

.mark
{
	width: var(--mark-w);
	height: var(--mark-h);
	decorator: shader(mark);
}
/* GENERATED by tools/medallion.py from the design decision's numbers. Do not edit by hand:
 * change the tool and run it. The Leaf fan medallion as stacked layers on one 200 by 190
 * canvas: the ground and leaf shadows, ten leaves, the rim (gold, or lime when selected), the
 * glint, the glyph. Selected (.is-f on any ancestor), each side's fan breathes open and a glint
 * runs round the rim (design/medallion/DESIGN-DECISION.md). */

.md { position: relative; display: inline-block; width: var(--md-size); height: var(--md-height); }
.md .ly { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.md .ly.shadows { decorator: svg(medallion/shadows.svg); }
.md .ly.rim { decorator: svg(medallion/rim-gold.svg); }
.is-f .md .ly.rim, .md.is-f .ly.rim { decorator: svg(medallion/rim-lime.svg); }
.md .ly.glint { decorator: svg(medallion/glint.svg); opacity: 0; transform-origin: 50% 47.4%; }
.md .glyph { position: absolute; left: 38.6%; top: 35.5%; width: 22.8%; height: 24%; image-color: var(--md-glyph); }
.is-f .md .glyph, .md.is-f .glyph { image-color: var(--md-glyph-on); }
.md .ly.leaf-l-o1 { decorator: svg(medallion/leaf-l-o1.svg); transform-origin: 23.7% 37.3%; }
.md .ly.leaf-l-o2 { decorator: svg(medallion/leaf-l-o2.svg); transform-origin: 35.2% 72.4%; }
.md .ly.leaf-l-i1 { decorator: svg(medallion/leaf-l-i1.svg); transform-origin: 25% 47.4%; }
.md .ly.leaf-l-i2 { decorator: svg(medallion/leaf-l-i2.svg); transform-origin: 30.6% 63.9%; }
.md .ly.leaf-l-c { decorator: svg(medallion/leaf-l-c.svg); transform-origin: 28.2% 55.3%; }
.md .ly.leaf-r-o1 { decorator: svg(medallion/leaf-r-o1.svg); transform-origin: 76.3% 37.3%; }
.md .ly.leaf-r-o2 { decorator: svg(medallion/leaf-r-o2.svg); transform-origin: 64.9% 72.4%; }
.md .ly.leaf-r-i1 { decorator: svg(medallion/leaf-r-i1.svg); transform-origin: 75% 47.4%; }
.md .ly.leaf-r-i2 { decorator: svg(medallion/leaf-r-i2.svg); transform-origin: 69.5% 63.9%; }
.md .ly.leaf-r-c { decorator: svg(medallion/leaf-r-c.svg); transform-origin: 71.8% 55.3%; }
.is-f .md .ly.leaf-l-o1, .md.is-f .ly.leaf-l-o1 { animation: var(--fan-cycle) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-o2, .md.is-f .ly.leaf-l-o2 { animation: var(--fan-cycle) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-i1, .md.is-f .ly.leaf-l-i1 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-i2, .md.is-f .ly.leaf-l-i2 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-l-c, .md.is-f .ly.leaf-l-c { animation: var(--fan-cycle) var(--fan-step-2) var(--ease) infinite fan-l; }
.is-f .md .ly.leaf-r-o1, .md.is-f .ly.leaf-r-o1 { animation: var(--fan-cycle) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-o2, .md.is-f .ly.leaf-r-o2 { animation: var(--fan-cycle) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-i1, .md.is-f .ly.leaf-r-i1 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-i2, .md.is-f .ly.leaf-r-i2 { animation: var(--fan-cycle) var(--fan-step) var(--ease) infinite fan-r; }
.is-f .md .ly.leaf-r-c, .md.is-f .ly.leaf-r-c { animation: var(--fan-cycle) var(--fan-step-2) var(--ease) infinite fan-r; }
.is-f .md .ly.glint, .md.is-f .ly.glint { animation: var(--glint-cycle) var(--ease) infinite glint; }
.is-fading .md .ly.glint { visibility: hidden; }
@keyframes fan-r { 0% { transform: rotate(0deg); } 50% { transform: rotate(5deg); } 100% { transform: rotate(0deg); } }
@keyframes fan-l { 0% { transform: rotate(0deg); } 50% { transform: rotate(-5deg); } 100% { transform: rotate(0deg); } }
@keyframes glint { 0% { opacity: 0; transform: rotate(-40deg); } 30% { opacity: 0.85; } 60% { opacity: 0.85; } 100% { opacity: 0; transform: rotate(250deg); } }
