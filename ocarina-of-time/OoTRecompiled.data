<rml>
<head>
    <title>About</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">OoT: Recompiled</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">Up and down scroll, Escape or the pad's B closes</div>
            </div>

            <!-- Everything between the lid and the foot scrolls as one region (the signature and
                 the changelog made this longer than any window). Its height is set by the shell
                 from the window's. -->
            <div class="body" id="about-body">

                <div class="prose">
                    A static recompilation. The machine code in your own copy of the game was
                    translated to C, compiled for this machine, and is running natively. No emulator
                    is involved, and nothing of the game ships with this program.
                </div>

                <div class="field">
                    <span class="name">Version</span>
                    <span class="datum" id="about-version">unknown</span>
                </div>

                <div class="field">
                    <span class="name">By</span>
                    <span class="datum" id="about-author">Jonathan Barnes</span>
                </div>

                <div class="field">
                    <span class="name">License</span>
                    <span class="datum">GPL-3.0</span>
                </div>

                <div class="heading">Signature</div>

                <div class="prose">
                    What Windows says of this program's own file, checked on this machine and without
                    the network.
                </div>

                <div class="field">
                    <span class="name">Status</span>
                    <span class="datum" id="about-sign-status">unknown</span>
                </div>

                <div class="field">
                    <span class="name">Signed by</span>
                    <span class="datum" id="about-signer"></span>
                </div>

                <div class="field">
                    <span class="name">Issued by</span>
                    <span class="datum" id="about-issuer"></span>
                </div>

                <div class="field">
                    <span class="name">Signed on</span>
                    <span class="datum" id="about-signed-on"></span>
                </div>

                <div class="field">
                    <span class="name">Certificate valid</span>
                    <span class="datum" id="about-valid"></span>
                </div>

                <div class="heading">Changes</div>

                <!-- Every version, newest first, from assets/changelog.json; filled by the shell. -->
                <div id="about-changes"></div>

                <div class="heading">What it was built from</div>

                <div class="prose">
                    These are the exact commits this binary was built against. A recompilation is only
                    reproducible if they are written down, so they are read from the checkouts at build
                    time rather than typed here.
                </div>

                <div class="field">
                    <span class="name">Recompiler</span>
                    <span class="datum" id="about-recompiler">unknown</span>
                </div>

                <div class="field">
                    <span class="name">Runtime</span>
                    <span class="datum" id="about-runtime">unknown</span>
                </div>

                <div class="field">
                    <span class="name">Renderer</span>
                    <span class="datum" id="about-renderer">unknown</span>
                </div>

                <div class="field">
                    <span class="name">Symbols</span>
                    <span class="datum" id="about-decomp">unknown</span>
                </div>

            </div>

            <div class="foot">
                <span>Your ROM stays yours. It is read from where you put it and never copied.</span>
                <span id="about-built">built</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Ask</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="ask-scrim">
        <div class="case">

            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title" id="ask-title">A question</div>
                </div>
            </div>

            <!-- One question at a time, filled by the shell: the two first run questions, and
                 since 2026-09-26 any confirmation the interface needs (the way into the Debugging
                 menu, and switching the frame recorder on). The first run pair are asked ONCE and
                 the answer is a setting afterward: nothing here nags, and neither has a default
                 that acts before it is answered.

                 A SCRIM AND A CASE, not the launcher's own window chrome. It had the chrome
                 because the questions are the only thing on screen at first run; the moment a
                 confirmation was raised during play it was drawn at the top left with the rest of
                 the window black behind it. There is also no close button on purpose: a question
                 is answered by one of its two buttons, or by Escape, which counts as No. -->
            <div class="ask-body">
                <p class="ask-q" id="ask-question"></p>
                <p class="prose" id="ask-detail"></p>
            </div>

            <div class="actions">
                <div class="act-btn act-quit" id="ask-no"><span class="act-label" id="ask-no-label">No</span></div>
                <div class="act-btn act-play" id="ask-yes"><span class="act-label" id="ask-yes-label">Yes</span></div>
            </div>

            <div class="foot">
                <span id="ask-foot">You can change this at any time in the settings</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Browse</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="controls.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="frame">
        <div class="case window">

            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title">Choose your ROM</div>
                </div>
                <div class="chrome">
                    <div class="win-btn" id="win-min"><div class="glyph-min"></div></div>
                    <div class="win-btn" id="win-max"><div class="glyph-max"></div></div>
                    <div class="win-btn" id="win-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                </div>
            </div>

            <!-- The folder being shown, above the list (the user's note of 2026-09-19: it sat
                 in the foot and ran into the foot's text). -->
            <div class="path-line">
                <span class="name">Folder</span>
                <span class="datum" id="browse-path">Drives</span>
            </div>

            <!-- The rows are built at runtime from the drives, then a folder's folders and ROM
                 files (main/launch.cpp lists them; the shell fills the rows). -->
            <div class="rows long" id="browse-rows"></div>

            <!-- A path typed or pasted (a file:// URL will do), Enter taking it as the ROM; or
                 Browse, which opens the file picker and puts the chosen file here. -->
            <div class="entry-line">
                <span class="name">Path</span>
                <input type="text" id="browse-input" class="path-input"/>
                <div class="btn" id="browse-pick">Browse</div>
            </div>

            <div class="foot">
                <span id="browse-foot">Enter opens a folder or takes a ROM, B goes up, or drop the file here</span>
            </div>

        </div>
    </div>
</body>
</rml>
/* The case: our chrome, built entirely from tokens.
 *
 * Read tokens.rcss first. Nothing below may contain a literal color, size, spacing, radius or
 * duration, and that is checked rather than trusted: tools/check_tokens.py fails the build if one
 * appears here.
 *
 * The composition is the decision's. A dark translucent case lit from the top left, regions
 * divided by hardware rather than by flat edges, and one moment: the focused row's brass edge
 * sitting proud of the panel face, catching the lamplight.
 */

body
{
	font-family: var(--font-body);
	font-weight: var(--weight-body);
	font-size: var(--size-row);
	color: var(--text);
	width: 100%;
	height: 100%;
}

/* The scrim is what makes the case readable over a bright scene without hiding it. Deliberately
 * not opaque: the decision is explicitly about the backdrop reading THROUGH the case. */
.scrim
{
	width: 100%;
	height: 100%;
	background-color: var(--scrim);
	display: flex;
	align-items: center;
	justify-content: center;
}

/* THE PANEL ON THE RIGHT (2026-09-24, the user: "the panel option to affix to the right side of
 * the screen like planned before"). The same case, stood against the window's right edge for the
 * window's full height with no scrim over the picture, so a lighting control can be changed while
 * watching what it does. The shell puts the class on the scrim when the Menu placement row says
 * so; everything inside the case is unchanged. */
.scrim.side
{
	background-color: transparent;
	justify-content: flex-end;
	align-items: stretch;
}

.scrim.side .case
{
	max-height: 100%;
	height: 100%;
	border-radius: 0;
	border-top-width: 0;
	border-bottom-width: 0;
	border-right-width: 0;
}

/* The same panel against the LEFT edge (the user, 2026-09-24): the edge on the window has no
 * rule, the edge on the picture keeps it. */
.scrim.side.left
{
	justify-content: flex-start;
}

.scrim.side.left .case
{
	border-left-width: 0;
	border-right-width: var(--rule);
}

.case
{
	width: var(--case-width);
	max-height: var(--case-max-height);
	padding: var(--pad);
	border: var(--rule) var(--line);
	border-radius: var(--radius);
	decorator: gradient(vertical var(--case-top) var(--case-bottom));
	box-sizing: border-box;
	display: flex;
	flex-direction: column;
}

/* The lid seam. One line, sitting under the title, which is what separates the head of the case
 * from its contents without a second panel. */
.lid
{
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding-bottom: var(--pad-row);
	border-bottom: var(--rule) var(--line);
	margin-bottom: var(--pad-row);
}

/* The head of the lid: the mark, then the title, on one line. */
.head
{
	display: flex;
	align-items: center;
}

.head .mark
{
	margin-right: var(--pad-row-side);
}

.title
{
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-title);
	color: var(--text);
}

.hint
{
	font-size: var(--size-caption);
	color: var(--text-faint);
}

/* The frame rate counter (the user's ask of 2026-09-19): a small branded plate at the top right
 * of the picture, beside the game's own interface, below the band the title bar rides in. */
.counter
{
	position: absolute;
	/* The side gap from the window's top edge while the title bar is hidden; under the bar,
	 * by the same gap, while it shows (the shell sets the class from the bar's state). */
	top: var(--pad-row-side);
	right: var(--pad-row-side);
	transition: top var(--duration-fast) linear-in-out;
	padding: var(--pad-row) var(--pad-row-side);
	border: var(--rule) var(--line);
	border-left: var(--edge) var(--accent);
	border-radius: var(--radius-tight);
	decorator: gradient(vertical var(--case-top) var(--case-bottom));
	display: flex;
	align-items: center;
	font-family: var(--font-mono);
	font-size: var(--size-caption);
	color: var(--text);
}

.counter.under-bar
{
	top: var(--plate-top-under-bar);
}

.counter .mark
{
	width: var(--mark-small-w);
	height: var(--mark-small-h);
	margin-right: var(--pad-row);
}

.counter .counter-unit
{
	color: var(--text-faint);
	margin-left: var(--gap);
}

/* The ROM browser (the user's notes of 2026-09-19): the folder line above the list, and the
 * path line below it, a field where a path is typed or pasted (Enter takes it) beside the
 * button that opens the file picker. */
.path-line
{
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: var(--pad-row) 0;
	font-size: var(--size-caption);
	color: var(--text-dim);
}

.path-line .datum
{
	font-family: var(--font-mono);
	color: var(--text);
}

.entry-line
{
	display: flex;
	align-items: center;
	margin-top: var(--pad-row);
}

.entry-line .name
{
	font-size: var(--size-caption);
	color: var(--text-dim);
	margin-right: var(--pad-row-side);
}

input.path-input
{
	flex: 1;
	padding: var(--pad-row) var(--pad-row-side);
	border: var(--rule) var(--line);
	border-radius: var(--radius-tight);
	background-color: var(--track);
	font-family: var(--font-mono);
	font-size: var(--size-caption);
	color: var(--text);
	caret-color: var(--accent);
}

input.path-input:focus
{
	border-color: var(--accent);
}

.btn
{
	margin-left: var(--pad-row-side);
	padding: var(--pad-row) var(--pad-row-side);
	border: var(--rule) var(--line);
	border-radius: var(--radius-tight);
	color: var(--text-dim);
	cursor: pointer;
}

.btn:hover
{
	color: var(--text);
	border-color: var(--accent);
	background-color: var(--row-on);
}

/* A modal's lid stacks (the user's asks of 2026-09-19): the mark, the title and the close
 * button on the first line (the launcher's own X, from window.rcss), the hint on its own line
 * beneath them, so a long hint never runs into the title. The launcher's lid keeps one line. */
.lid.stacked
{
	flex-direction: column;
	align-items: stretch;
}

.lid-top
{
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.lid.stacked .hint
{
	display: block;
	margin-top: var(--gap);
}

/* The rows. A track behind them so the case reads as a compartment with things set into it,
 * which is the whole conceit of the direction. */
.rows
{
	background-color: var(--track);
	border: var(--rule) var(--line);
	border-radius: var(--radius-tight);
	padding: var(--gap);
	display: flex;
	flex-direction: column;
}

.row
{
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: var(--pad-row) var(--pad-row-side);
	border-left: var(--edge) transparent;
	transition: background-color var(--duration-fast) linear-in-out,
	            border-left-color var(--duration-fast) linear-in-out;
}

/* The pointer over a row, now that the mouse reaches the documents: the track's lift without
 * the edge, so the focused row stays the one moment. */
.row:hover
{
	background-color: var(--row-on);
}

/* THE ONE MOMENT. The focused row lifts out of the track and its left edge takes the light. It
 * is the only place the accent appears, which is what keeps it meaning something. */
.row.on
{
	background-color: var(--row-on);
	border-left: var(--edge) var(--accent);
}

.row .label
{
	color: var(--text-dim);
	/* A LABEL IS NEVER SQUEEZED (the user, 2026-10-09, of the HUD row in the panel: "description
	 * crushes it"): a long value or action text folds onto more lines rather than pressing the
	 * label narrower, and keeps a gap from it. */
	flex-shrink: 0;
	margin-right: var(--pad-row-side);
}

.row.on .label
{
	color: var(--text);
}

.row .value
{
	font-family: var(--font-mono);
	color: var(--text-dim);
}

.row.on .value
{
	color: var(--accent);
}

/* An action row's value (Controls, Play, Quit) says nothing at rest; the text shows while
 * the row is focused or under the pointer (the user's note of 2026-09-19). */
.row .value .act
{
	display: none;
}

/* A DIVIDER INSIDE A LIST: a rule and a small name, where one part of the list ends and the next
 * begins, never a row (nothing focuses it). The Moments list's "Your slots", and the controls
 * screen's Photo mode section (the user, 2026-10-09: "a dedicated section within the controls
 * panel, like after a divider"), which can carry a badge beside its name. */
.divider
{
	display: flex;
	align-items: center;
	margin-top: var(--pad-row);
	padding: var(--pad-row) var(--pad-row-side) var(--pad-row-side);
	border-top: var(--rule) var(--line);
}

.divider-label
{
	font-size: var(--size-caption);
	color: var(--text-faint);
	text-transform: uppercase;
	letter-spacing: var(--divider-tracking);
}

/* WHAT THE CHOICE MEANS, under the row (the user, 2026-10-09: "a description underneath them when
 * they're toggled that says what they do"). The row wraps so the note takes a line of its own
 * under the label and the value, the full width of the row, in the caption's size and the quiet
 * color; it is rebuilt with the row, so it changes as the choice does. */
.row.noted
{
	flex-wrap: wrap;
}

.row .row-note
{
	flex: 0 0 100%;
	margin-top: var(--pad-row);
	font-size: var(--size-caption);
	color: var(--text-faint);
}

.row.on .row-note
{
	color: var(--text-dim);
}

.row.on .value .act,
.row:hover .value .act
{
	display: inline;
}

/* The foot of the case. Provenance lives here on the about screen, and the controls hint on the
 * settings screen. */
.foot
{
	margin-top: var(--pad-row);
	padding-top: var(--pad-row);
	border-top: var(--rule) var(--line);
	display: flex;
	justify-content: space-between;
	column-gap: var(--pad);
	font-size: var(--size-caption);
	color: var(--text-faint);
}

/* A FOOT OF TWO IN THE PANEL IS STACKED (the user, 2026-10-09, of the lighting menu in the panel:
 * "this text ... needs to be stacked as well ... it's crushing them together"). The panel is too
 * narrow for the two side by side, so the second ran into the first with no space between; one
 * above the other, each has the panel's width. Over the picture they stay side by side, held
 * apart by the column gap above. */
.scrim.side .foot
{
	flex-direction: column;
	justify-content: flex-start;
	row-gap: var(--pad-row);
}

/* About, which is a reading surface rather than a control surface, so it gets prose spacing and
 * no focus treatment at all. */
.prose
{
	display: block;
	color: var(--text-dim);
	font-size: var(--size-note);
	margin-bottom: var(--pad-row);
}

.field
{
	display: flex;
	justify-content: space-between;
	padding: var(--pad-row) 0;
	border-bottom: var(--rule) var(--line);
}

.field .name
{
	color: var(--text-dim);
}

.field .datum
{
	font-family: var(--font-mono);
	font-size: var(--size-caption);
	color: var(--text);
}

.heading
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-heading);
	color: var(--text);
	margin-top: var(--pad-row);
	margin-bottom: var(--pad-row);
}

/* A scrolling region: About's body (the signature and the changelog made it longer than any
 * window), the controls list, the browser. Its height is set by the shell from the window's,
 * because a percentage of a case that is itself sized by its contents resolves to nothing. The
 * scrollbar rules serve every document that scrolls. */
.body
{
	overflow-y: auto;
	/* Room between the text and the bar at the right, and the same at the left, so the
	 * scrolling region reads as a compartment rather than text pressed against a rail. */
	padding-left: var(--pad-row-side);
	padding-right: var(--pad);
	box-sizing: border-box;
}

scrollbarvertical
{
	width: var(--scroll);
	background-color: var(--track);
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc
{
	height: 0;
}

scrollbarvertical slidertrack
{
	background-color: var(--track);
}

scrollbarvertical sliderbar
{
	background-color: var(--line);
	border-radius: var(--radius-tight);
}

/* A second line under the foot: the launcher's signature line, a click target that opens
 * About (the user's ask of 2026-09-19). */
.foot-more
{
	padding-top: var(--pad-row);
	display: flex;
	justify-content: space-between;
	font-size: var(--size-caption);
	color: var(--text-faint);
}

.link
{
	color: var(--text-dim);
	cursor: pointer;
}

.link:hover
{
	color: var(--accent);
}

/* The changelog, newest version first: a version and its date on one line, the title, the
 * summary, then each section's label and its one-line changes. */
.entry
{
	display: block;
	padding: var(--pad-row) 0;
	border-bottom: var(--rule) var(--line);
}

.entry-head
{
	display: flex;
	justify-content: space-between;
}

.entry-version
{
	font-family: var(--font-mono);
	color: var(--accent);
}

.entry-date
{
	font-family: var(--font-mono);
	font-size: var(--size-caption);
	color: var(--text-faint);
}

.entry-title
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	color: var(--text);
}

.entry-summary
{
	display: block;
	color: var(--text-dim);
	font-size: var(--size-note);
}

.entry-section
{
	display: block;
	color: var(--text);
	font-size: var(--size-caption);
	margin-top: var(--pad-row);
}

.entry-item
{
	display: block;
	color: var(--text-dim);
	font-size: var(--size-note);
	padding-left: var(--pad-row-side);
}

/* THE ACTIONS. Play and Quit are not settings and the user asked twice for them to stop looking
 * like settings: out of the list, under their own divider, Quit on the left as a secondary and
 * Play on the right as the primary. A row of the list says "here is a value you can change"; a
 * button says "this will happen", and the two should never wear the same clothes.
 *
 * They keep their place in the keyboard and pad order, so .on still marks the focused one. The
 * focus treatment is the list's own, which is what keeps one vocabulary across the screen. */
.actions
{
	margin-top: var(--pad-row);
	padding-top: var(--pad-row);
	border-top: var(--rule) var(--line);
	display: flex;
	align-items: center;
}

/* Half each, side by side. They were space-between, which threw them to opposite edges of a
 * 660 wide case with a third of the width of nothing between two controls that belong together
 * (the user, 2026-09-20: "we don't want them to be spaced between like this, it looks really
 * odd"). The gap is the only thing separating them now, which is what pairs them.
 *
 * THE SPACE BETWEEN THEM IS THE SPACE ABOVE THEM, which is `--pad-row`: the bar's own padding-top,
 * the distance from the rule to the top of the buttons (the user, 2026-09-20: "they should have
 * the same amount of gap between the buttons themselves and the border above them"). One token in
 * both places, so they cannot drift apart.
 *
 * This read `var(--gap)` and looked correct, which is why it survived a review: `--gap` is a ONE
 * dp hairline for a divider, not a step on the spacing scale, so the two buttons were a pixel
 * apart and touching to the eye. */
.actions .act-btn
{
	flex: 1 1 0;
	margin-right: var(--pad-row);
}

.actions .act-btn:last-child
{
	margin-right: 0;
}

/* TWO TO A ROW (the user, 2026-10-09, of the Moments buttons in the panel: "These buttons are being
 * crushed. Maybe we should do 50-50 and then do two rows of buttons"). Four buttons side by side
 * left each a quarter of the case and folded a label onto three lines. Each now takes half, and
 * the third and fourth go to a second row; one left alone in a row takes the row. The space
 * between them, either way, is the space above them, as for the pair above. */
.actions.pairs
{
	flex-wrap: wrap;
	gap: var(--pad-row);
}

.actions.pairs .act-btn
{
	flex: 1 1 40%;
	margin-right: 0;
}

.act-btn
{
	display: flex;
	align-items: center;
	justify-content: center;
	min-height: var(--act-height);
	padding: 0 var(--pad-act-side);
	border-radius: var(--radius-tight);
	border: var(--rule) var(--line);
	transition: background-color var(--duration-fast) linear-in-out,
	            border-color var(--duration-fast) linear-in-out;
}

/* Quit is the quiet one: it is always available and almost never what you came for. */
.act-quit
{
	background-color: transparent;
	color: var(--text-dim);
}

.act-quit:hover
{
	color: var(--text);
	border-color: var(--line-bright);
}

/* Play is the one moment on this screen, which is why it carries the brass. */
.act-play
{
	background-color: var(--accent);
	border-color: var(--accent);
	color: var(--on-accent);
}

.act-play:hover
{
	background-color: var(--brass-light);
	border-color: var(--brass-light);
}

/* Focused, by keyboard or pad. The same lift the list uses, so the screen reads as one thing. */
.act-btn.on
{
	border-color: var(--accent);
	background-color: var(--row-on);
	color: var(--text);
}

.act-play.on
{
	background-color: var(--brass-light);
	border-color: var(--brass-peak);
	color: var(--on-accent);
}

.act-label
{
	font-size: var(--size-row);
	font-weight: 600;
}

/* THE TWO STEPS EITHER SIDE OF A SETTING'S VALUE.
 * A click used to move a setting one way only, and a choice stops at its ends on purpose, so the
 * last option was a dead end for anyone using the mouse. The keys had always worked, and that was
 * the other half of it: nothing on screen said a setting had a back. These do what Left and Right
 * do, and they say so by being there.
 *
 * Quiet until the row is the one you are on, so twelve rows do not turn into twenty four arrows. */
.row .value .step
{
	display: inline-block;
	color: var(--text-faint);
	min-width: var(--step-width);
	text-align: center;
	padding: var(--pad-row) 0;
	transition: color var(--duration-fast) linear-in-out;
}

.row.on .value .step,
.row:hover .value .step
{
	color: var(--accent);
}

/* A step that cannot go anywhere is drawn spent rather than removed, so the row keeps its shape
 * as it is walked and the eye is not asked to re-find the value. */
.row .value .step.spent
{
	color: var(--line);
}

.row.on .value .step.spent,
.row:hover .value .step.spent
{
	color: var(--line-bright);
}

/* The value keeps one width whatever it reads, so the two chevrons hold still while a row is
 * stepped rather than sliding in and out under the pointer. Inline-block because a bare inline
 * box ignores a width. */
.row .value .shown
{
	display: inline-block;
	min-width: var(--value-width);
	text-align: right;
}

/* A ROW TO TICK (the user, 2026-10-09, of what brings the HUD back: "all separate options as just
 * checkbox toggles"). A box where a stepper's value sits, its right edge where the values' is (the
 * gap after it is a chevron's width), and a filled square inside it while the row is on. Quiet at
 * rest like the chevrons; the accent only on the row you are on. */
.row .value .check
{
	display: inline-block;
	width: var(--check);
	height: var(--check);
	border: var(--rule) var(--text-faint);
	border-radius: var(--radius-tight);
	vertical-align: middle;
}

.row .value .check .tick
{
	display: none;
	margin: var(--check-inset);
	height: var(--check-tick);
	background-color: var(--text-dim);
	border-radius: var(--radius-tight);
}

.row .value .check.ticked .tick
{
	display: block;
}

.row.on .value .check,
.row:hover .value .check
{
	border-color: var(--accent);
}

.row.on .value .check .tick,
.row:hover .value .check .tick
{
	background-color: var(--accent);
}

.row .value .step-gap
{
	display: inline-block;
	width: var(--step-width);
}

/* A destructive action, on the surface that can remove everything this program installed. It takes
 * the judgment color rather than the accent, because the accent means "this is the thing to do"
 * and removing your own install is emphatically not that. Outlined at rest and only filled once it
 * is the confirmation, so the first press of it never looks like the last one. */
.act-danger
{
	background-color: transparent;
	border-color: var(--bad);
	color: var(--bad);
}

.act-danger:hover
{
	background-color: var(--bad);
	color: var(--on-accent);
}

.act-danger.armed
{
	background-color: var(--bad);
	border-color: var(--bad);
	color: var(--on-accent);
}

/* The path rows on the files surface. A path is long and a label is short, so the value takes the
 * room and truncates from the left, where the interesting end of a path is not. */
#files-rows .row .value
{
	font-size: var(--size-caption);
	color: var(--text-dim);
}

#files-rows .row.on .value
{
	color: var(--accent);
}

/* A path is long and a label is short, so the label keeps its own column and the path takes the
 * rest of the line. The path is shortened from the FRONT in code before it gets here, so it is
 * always one line: wrapped, it pushed the label out of line with it and the two collided. */
#files-rows .row .label
{
	width: var(--files-label-width);
	flex: 0 0 auto;
}

#files-rows .row .value
{
	white-space: nowrap;
	flex: 1 1 auto;
}

/* Open, at the end of every files row: written on the row rather than guessed, shown while the
 * row is under the pointer or has the focus, in the brass because it is the thing to do there. */
#files-rows .row .open
{
	display: none;
	flex: 0 0 auto;
	margin-left: var(--pad-row-side);
	font-size: var(--size-caption);
	font-weight: 600;
	color: var(--accent);
}

#files-rows .row.on .open,
#files-rows .row:hover .open
{
	display: inline;
}

/* The two buttons under the files rows show the pointer and the focus alike (the user,
 * 2026-09-24: "the buttons for delete and back need focus and hover styles"): the quiet one
 * lifts to the lit row's ground with the brass edge, the destructive one fills with its own
 * judgment color. The focus arrives by the pad or the keyboard (the `on` class the shell sets)
 * or by the tab key (the `:focus` state), and both read the same. */
.act-quit:hover,
.act-quit:focus,
.act-quit.on
{
	color: var(--text);
	border-color: var(--accent);
	background-color: var(--row-on);
}

.act-danger:focus,
.act-danger.on
{
	background-color: var(--bad);
	border-color: var(--bad);
	color: var(--on-accent);
}

/* Armed, the destructive button is the question itself: filled, and its edge lit in the brass so
 * it cannot be mistaken for the first press. */
.act-danger.armed,
.act-danger.armed:hover,
.act-danger.armed.on
{
	background-color: var(--bad);
	border-color: var(--brass-light);
	color: var(--on-accent);
}

/* The first run questions. A reading surface with two answers, so it gets prose spacing rather
 * than the rows' density, and the question itself carries the weight the rows' labels do not. */
.ask-body
{
	background-color: var(--track);
	border: var(--rule) var(--line);
	border-radius: var(--radius-tight);
	padding: var(--pad);
	display: block;
}

.ask-q
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-title);
	color: var(--text);
	margin-bottom: var(--pad-row);
}

/* The frame recorder's plate (the user's ask of 2026-09-22): the counter's plate in the opposite
 * corner. It takes .counter for the whole look and changes only the side it sits on and the
 * things the counter has no use for: a state dot, and a cursor, because unlike the counter this
 * one is a button. */
.counter.recorder
{
	left: var(--pad-row-side);
	right: auto;
	/* NO `top` HERE ON PURPOSE. It takes the counter's, and the `under-bar` class moves both of
	 * them together when the title bar appears (the user's ask of 2026-09-23, so the two sit
	 * level).
	 *
	 * This rule DID pin the plate low for a day, and the pin outlived the C++ that was supposed to
	 * put the movement back: the class was being set and unset correctly while this line quietly
	 * won, so the plate never moved and only its low position could ever be clicked. The user
	 * spotted it from the behavior ("the low position is the only one working... because the
	 * plate never slides up") while the tests here were reporting the high position as a focus
	 * problem. A stylesheet that overrides the thing the code is toggling is invisible from the
	 * code's side.
	 *
	 * What makes a MOVING plate safe to click is not CSS but note_pointer in ui_shell.cpp: the
	 * bar's state is frozen while the pointer is on the plate, so it cannot slide away from a
	 * click on its way to it. */
	/* The lit edge goes on the outside edge of the plate, which is the left for the counter and
	 * the right for this one, so the two read as a mirrored pair rather than as two of the same
	 * thing that happen to be in different corners. */
	border-left: var(--rule) var(--line);
	border-right: var(--edge) var(--accent);
	cursor: pointer;
}

/* While a recording runs the whole plate takes the record color on its outside edge, so the fact
 * that frames are being written is visible without reading anything. */
.counter.recorder.on
{
	border-right-color: var(--record);
}

/* Between the word and the time, so it divides them as well as saying what state the recorder is
 * in. A margin on BOTH sides now: with it only on the right, `Record` and `0:05` sat against each
 * other with nothing between them. */
.counter.recorder .dot
{
	width: var(--dot);
	height: var(--dot);
	border-radius: var(--dot);
	background-color: var(--record-idle);
	margin-left: var(--pad-row);
	margin-right: var(--pad-row);
	transition: background-color var(--duration-fast) linear-in-out;
}

/* The dot already provides the gap on this side. */
.counter.recorder .counter-unit
{
	margin-left: 0;
}

.counter.recorder.on .dot
{
	background-color: var(--record);
}

/* Draining: the frames are taken and the encoders are catching up. The dot goes to the accent
 * rather than staying red, because nothing is being captured any more and a red dot would say
 * otherwise. */
.counter.recorder.saving .dot
{
	background-color: var(--accent);
}

/* A write failed. The one place the plate uses the fault color, and it stays until the next
 * recording starts. */
.counter.recorder.failed .dot
{
	background-color: var(--bad);
}

/* THE ALWAYS ON OVERLAYS MUST NOT SWALLOW CLICKS, and until 2026-09-22 they did.
 *
 * Every document's body fills the whole context, so a document that is merely SHOWN covers the
 * picture for the purposes of hit testing even when the only thing it draws is a small plate in a
 * corner. Documents are stacked in the order they were last shown, so whichever overlay came up
 * last quietly took every click on the screen. The frame recorder's plate was drawn, lit, and
 * completely dead: the click was landing on the frame document's body, one layer above it.
 *
 * So the four overlays that are up while the game runs let clicks through by default, and the
 * parts of them that ARE buttons ask for them back. The modal documents are deliberately not in
 * this set: their scrim is supposed to take the click, which is what makes them modal. */
body.overlay
{
	pointer-events: none;
}

.counter.recorder,
.frame-bar
{
	pointer-events: auto;
}

/* ANY ROW LIST THAT CAN OUTGROW ITS CASE. Four documents use this: the controls, the debug menu,
 * the settings and the launcher. The shell caps the height from the window's own height, because
 * a percentage of a case that is itself sized by its contents resolves to nothing, and a fixed
 * height would be wrong for every window but one.
 *
 * It is a CAP rather than a height, so a short list is its own height and only a list that would
 * overflow the case scrolls. A fixed height leaves a tall empty box under a list of two. */
/* AS A SIDE PANEL THE LIST FILLS THE WINDOW (2026-09-24, the user: "fixed left or right menu
 * should expand scrollable area to allow fixed footer and fixed header to both be at top and
 * bottom of the windows height"). The case is already the window's full height there, so the
 * list takes every pixel between the lid and the actions instead of a share of the window, and
 * the head and the foot sit at the top and the bottom with the rows scrolling between them.
 * The shell stops setting its own cap in this placement, or the cap would win over this. */
.scrim.side .case .rows.long,
.scrim.side .case .body
{
	flex: 1 1 auto;
	min-height: 0;
	max-height: none;
}

.rows.long
{
	overflow-y: auto;
}

/* The update plate (the user's ask of 2026-09-23): the counter's plate at the BOTTOM left, where
 * it is under neither corner plate and never under the title bar, so it takes no `under-bar`
 * class. It shows only while there is news: the newer version being fetched, the fetched file
 * waiting for the next start, or a refused download. Like the recorder it is a button: a click
 * while the file is ready installs it now and closes this copy. */
.counter.update
{
	top: auto;
	bottom: var(--pad-row-side);
	left: var(--pad-row-side);
	right: auto;
	border-left: var(--rule) var(--line);
	border-right: var(--edge) var(--accent);
	cursor: pointer;
}

/* The Moments list (phase 77): a row carries a thumbnail before its words. The picture is the
 * recorder's 320 by 240 frame drawn at a quarter, in the same tight corner the plates use; an
 * empty slot shows the track's own color in the same box so the rows stay level. The label holds
 * two lines, the slot's name under the moment's. */
.row.mrow
{
	justify-content: flex-start;
}
.row.mrow .thumb
{
	width: 80dp;
	height: 60dp;
	margin-right: var(--pad-row-side);
	border: var(--rule) var(--line);
	border-radius: var(--radius-tight);
	decorator: none;
}
.row.mrow .thumb.empty
{
	background-color: var(--track);
}
.row.mrow .label
{
	display: block;
	flex: 1 1 auto;
}
.row.mrow .label .slot
{
	display: block;
	font-family: var(--font-mono);
	font-size: var(--size-caption);
	color: var(--text-faint);
}
.row.mrow .value
{
	font-size: var(--size-caption);
}
/* The controls document: the case's rows with the two additions the plan names (a device row
 * whose value cycles, and a scanning state for the slot a capture is listening for) and the
 * capture panel from the decision's binding capture surface. Tokens only, as case.rcss;
 * tools/check_tokens.py holds this file to it too.
 */

/* The `.rows.long` rule moved to case.rcss on 2026-09-23, when the settings and launcher lists
 * became scrolling lists too. Four documents share it now, and only two of them link this file.
 * The scrollbar's rules were already there. */

/* A binding row's two slots, right aligned in fixed columns so the names line up down the
 * list. The picked slot in the focused row takes the accent and an underline, which is what
 * says left and right choose a slot. */
.slots
{
	display: flex;
	align-items: center;
}

.slot
{
	font-family: var(--font-mono);
	color: var(--text-dim);
	width: var(--slot-width);
	text-align: right;
	margin-left: var(--pad-row-side);
	border-bottom: var(--rule) transparent;
	transition: color var(--duration-fast) linear-in-out,
	            border-bottom-color var(--duration-fast) linear-in-out;
}

.row.on .slot
{
	color: var(--text);
}

.row.on .slot.pick
{
	color: var(--accent);
	border-bottom-color: var(--accent);
}

/* The column names, above the first binding row. The row sits in the list but is not one of the
 * rows: nothing selects it, so it takes no focus color and no hover. It exists because both
 * columns are live at once and the second read as a duplicate of the first without a name on it.
 *
 * NOT CALLED `heading`, and that is the whole story of a bug the user caught in 0.3.5. This file
 * links case.rcss, which already has a `.heading` for a section title, and it is `display:
 * block`. A row of `class="row heading"` therefore stopped being a flex row: the label and the
 * two columns stacked, so the names sat a couple of hundred pixels left of the values they
 * named. The columns themselves were always the right width and the right distance apart, which
 * is why it looked like an alignment bug rather than a display one. A class name in a shared
 * stylesheet is a shared name. */
.row.cols
{
	color: var(--text-dim);
	font-size: var(--size-caption);
	border-bottom: var(--rule) var(--line);
}

.row.cols .slot
{
	color: var(--text-dim);
	font-family: var(--font-body);
	font-size: var(--size-caption);
}

/* THE BADGE BESIDE A CONTROL THAT DOES NOTHING YET (2026-10-09): the settings row it needs, while
 * that row is Off (ui_controls.h, row_badge). A small plate in the caption's size, quiet, so it
 * reads as a note on the row rather than as part of the control's name. */
.badge
{
	margin-left: var(--pad-row);
	padding: 0 var(--pad-row);
	border: var(--rule) var(--line);
	border-radius: var(--radius-tight);
	font-family: var(--font-body);
	font-size: var(--size-caption);
	color: var(--text-faint);
}

.row.on .badge
{
	color: var(--text-dim);
	border-color: var(--line-bright);
}

/* A badged binding's name with its badge on a line of its own under it, never folded: beside the
 * name, "Needs Video recording on" broke in two in the panel's label column. On the section's
 * divider the badge stays beside the section's name, where there is room. */
.badge
{
	white-space: nowrap;
}

.label.badged
{
	display: flex;
	flex-direction: column;
	align-items: flex-start;
}

.label.badged .badge
{
	margin-left: 0;
	margin-top: var(--badge-drop);
}

/* A binding that is bound, saved and currently ignored: the four C buttons on the right stick
 * while free aim holds that stick. Struck through rather than hidden, because it is still
 * there and comes back the moment free aim goes off. */
.slot.idle
{
	color: var(--text-dim);
	text-decoration: line-through;
}

.row.on .slot.idle
{
	color: var(--text-dim);
}

/* The line under the rows that says why. Empty most of the time, and then it takes no room. */
.notice
{
	color: var(--text-dim);
	font-size: var(--size-caption);
	padding: var(--pad-row) var(--pad-row-side);
	border-top: var(--rule) var(--line);
}

.notice.gone
{
	display: none;
}

/* Scanning: the slot a capture is listening for, in the existing focus color with the
 * existing short transition. Nothing new is invented here. */
.row.scanning .slot.pick
{
	color: var(--accent);
	background-color: var(--accent-soft);
}

/* The capture panel, the decision's binding capture surface: a modal state over the rows with
 * no way out but a press or a cancel, and the countdown that makes the trap obvious. */
.capture
{
	display: none;
}

.capture.open
{
	display: flex;
	position: absolute;
	top: 0;
	left: 0;
	width: 100%;
	height: 100%;
	align-items: center;
	justify-content: center;
	background-color: var(--scrim);
}

.capture-case
{
	width: var(--capture-width);
	padding: var(--pad);
	border: var(--rule) var(--line-bright);
	border-radius: var(--radius);
	decorator: gradient(vertical var(--case-top) var(--case-bottom));
	text-align: center;
}

/* THE THREE LINES STACK. RmlUi gives a div no display of its own, so without these the title,
 * the instruction and the countdown ran on as one line (the user, 2026-09-23: "it shouldn't be
 * all in a row like this. It should stack"). */
.capture .ctitle
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-heading);
	color: var(--text-dim);
	margin-bottom: var(--pad-row);
}

.capture .big
{
	display: block;
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-title);
	color: var(--text);
	margin-bottom: var(--pad-row);
}

.capture .line
{
	display: block;
	margin-top: var(--pad-row);
	padding-top: var(--pad-row);
	border-top: var(--rule) var(--line);
	letter-spacing: 0.06em;
	font-family: var(--font-mono);
	font-size: var(--size-caption);
	color: var(--text-faint);
}
<rml>
<head>
    <title>Controls</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="controls.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Controls</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">Up and down to move, left and right to pick a slot, Enter binds, Delete clears, Escape closes</div>
            </div>

            <!-- The rows are built at runtime from the device list and the live bindings
                 (src/ui/ui_controls.cpp): the device row, one row per game input with its two
                 slots, then the deadzone, rumble and reset rows. The document holds no names
                 of its own, so the order on screen is the order in the bindings file. -->
            <div class="rows long" id="controls-rows"></div>

            <!-- Why a binding on screen is not doing anything at the moment. Written at runtime
                 and empty the rest of the time, which the stylesheet takes as hidden. -->
            <div class="notice" id="controls-notice"></div>

            <div class="foot">
                <span id="controls-note">Keyboard</span>
                <span id="controls-foot">Saved as you change it. F3 closes this</span>
            </div>

        </div>
    </div>

    <!-- The capture: shown while a binding is being listened for, and for a moment after. -->
    <div class="capture" id="capture">
        <div class="capture-case">
            <div class="ctitle" id="capture-title">Rebind</div>
            <div class="big">Press any control</div>
            <div class="line" id="capture-line">Listening</div>
        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Counter</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
</head>
<body class="overlay">
    <!-- The frame rate counter (the user's ask of 2026-09-19): a small plate at the top right
         of the picture, beside the game's own interface, the frames presented per second. The
         shell fills the number twice a second and shows the document while the row is on. -->
    <div class="counter" id="counter">
        <div class="mark"></div>
        <span class="counter-value" id="counter-value">0</span>
        <span class="counter-unit">fps</span>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Debugging</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="debug-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Debugging</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">For development, not for playing. Up and down to move, left and right to change, Escape or the pad's B goes back</div>
            </div>

            <!-- EVERYTHING MEANT FOR DEVELOPMENT RATHER THAN FOR PLAYING, in one place (the user,
                 2026-09-26). The rows are built by the shell from the same two models the other
                 menus use, picked out by key (is_debug_setting, is_debug_lighting in
                 ui_shell.cpp), so a row can never appear in both menus or in neither. The way in
                 is a confirmation, never this document directly. -->
            <div class="rows long" id="debug-rows"></div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="debug-foot">Put anything you change back when you are done; none of this is needed to play</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Your files</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="frame">
        <div class="case window">

            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title">Your files</div>
                </div>
                <div class="chrome">
                    <div class="win-btn" id="win-min"><div class="glyph-min"></div></div>
                    <div class="win-btn" id="win-max"><div class="glyph-max"></div></div>
                    <div class="win-btn" id="win-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                </div>
            </div>

            <!-- The answer to "where is this actually putting things", which is the objection to
                 putting somebody's files anywhere they did not choose. Every row shows the REAL
                 resolved path rather than what it is supposed to be, and opening a row opens that
                 folder in the file browser. The rows are filled by the shell. -->
            <div class="path-line">
                <span class="name">Running</span>
                <span class="datum" id="files-mode">portable</span>
            </div>

            <!-- Every row ends in Open, which appears when the row is under the pointer or has the
                 focus, so the way to open a folder is written on it rather than guessed (the user,
                 2026-09-24: "options to Open each directory"). The whole row opens it too. -->
            <div class="rows" id="files-rows">
                <div class="row" id="frow-0"><span class="label" id="flabel-0"></span><span class="value" id="fvalue-0"></span><span class="open" id="fopen-0">Open</span></div>
                <div class="row" id="frow-1"><span class="label" id="flabel-1"></span><span class="value" id="fvalue-1"></span><span class="open" id="fopen-1">Open</span></div>
                <div class="row" id="frow-2"><span class="label" id="flabel-2"></span><span class="value" id="fvalue-2"></span><span class="open" id="fopen-2">Open</span></div>
                <div class="row" id="frow-3"><span class="label" id="flabel-3"></span><span class="value" id="fvalue-3"></span><span class="open" id="fopen-3">Open</span></div>
                <div class="row" id="frow-4"><span class="label" id="flabel-4"></span><span class="value" id="fvalue-4"></span><span class="open" id="fopen-4">Open</span></div>
                <div class="row" id="frow-5"><span class="label" id="flabel-5"></span><span class="value" id="fvalue-5"></span><span class="open" id="fopen-5">Open</span></div>
                <div class="row" id="frow-6"><span class="label" id="flabel-6"></span><span class="value" id="fvalue-6"></span><span class="open" id="fopen-6">Open</span></div>
                <div class="row" id="frow-7"><span class="label" id="flabel-7"></span><span class="value" id="fvalue-7"></span><span class="open" id="fopen-7">Open</span></div>
                <div class="row" id="frow-8"><span class="label" id="flabel-8"></span><span class="value" id="fvalue-8"></span><span class="open" id="fopen-8">Open</span></div>
                <div class="row" id="frow-9"><span class="label" id="flabel-9"></span><span class="value" id="fvalue-9"></span><span class="open" id="fopen-9">Open</span></div>
                <div class="row" id="frow-10"><span class="label" id="flabel-10"></span><span class="value" id="fvalue-10"></span><span class="open" id="fopen-10">Open</span></div>
                <div class="row" id="frow-11"><span class="label" id="flabel-11"></span><span class="value" id="fvalue-11"></span><span class="open" id="fopen-11">Open</span></div>
            </div>

            <!-- Two states in one bar. At rest it is Close and Remove everything; once Remove has
                 been pressed the question in the foot changes and so do these, so a destructive
                 action is never one click away and never needs a second window. Both buttons
                 take the focus (the pad and the keyboard walk the rows and then the bar), and
                 both show it and the pointer over them. -->
            <div class="actions">
                <div class="act-btn act-quit" id="files-left" tabindex="auto"><span class="act-label" id="files-left-label">Close</span></div>
                <div class="act-btn act-danger" id="files-right" tabindex="auto"><span class="act-label" id="files-right-label">Remove everything</span></div>
            </div>

            <div class="foot">
                <span id="files-foot">Click a row, or its Open, to open that folder</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Frame</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body class="overlay">
    <!-- The game window's own frame (play milestone): a brass edge around the window, and the
         header, the launcher's lid, riding over the picture when the pointer is at the top of
         the window. The shell shows and hides the two; the window itself has no border of the
         system's. -->
    <div class="frame-edge hidden" id="frame-edge"></div>
    <div class="frame-bar hidden" id="frame-bar">
        <div class="head">
            <div class="mark"></div>
            <div class="title">OoT: Recompiled</div>
        </div>
        <div class="chrome">
            <div class="win-btn" id="win-min"><div class="glyph-min"></div></div>
            <div class="win-btn" id="win-max"><div class="glyph-max"></div></div>
            <div class="win-btn" id="win-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
        </div>
    </div>
</body>
</rml>
/* The startup hint: the decision's toast, the one surface allowed over play. It sits in the
 * bottom left corner, takes no input, and goes on the first press or after five seconds (the
 * shell's clock; the fade is the slow duration). Tokens only, like every component sheet.
 */

body
{
	position: absolute;
	left: var(--pad);
	bottom: var(--pad);
	font-family: var(--font-body);
	font-weight: var(--weight-body);
	font-size: var(--size-note);
	color: var(--text);
}

.toast
{
	display: flex;
	align-items: center;
	padding: var(--pad-toast);
	max-width: var(--toast-width);
	border: var(--rule) var(--line);
	border-radius: var(--radius);
	decorator: gradient(vertical var(--case-top) var(--case-bottom));
	opacity: 1;
	transition: opacity var(--duration-slow) linear-in-out;
}

.toast.gone
{
	opacity: 0;
}

/* The mark beside the text (mark.rcss). It centers on the whole toast rather than on the first
 * line, as the decision's does. */
.toast .mark
{
	margin-right: var(--pad-toast);
}

.tx
{
	border-left: var(--rule) var(--line);
	padding-left: var(--pad-toast);
}

/* Two lines, one above the other. RmlUi lays a div out inline unless told otherwise, and the
 * first capture had both lines running on as one. */
.lead,
.note
{
	display: block;
}

.lead
{
	font-family: var(--font-display);
	font-weight: var(--weight-display);
	font-size: var(--size-heading);
	color: var(--text);
}

.note
{
	font-size: var(--size-caption);
	color: var(--text-dim);
}

/* A toast with nothing to add on a second line (a state was saved, a state was restored) is one
 * line, not one line and a gap where the second would have been. */
.note.gone
{
	display: none;
}
<rml>
<head>
    <title>Hint</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="hint.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
</head>
<body class="overlay">
    <!-- Both lines are filled at runtime from the live bindings (the keyboard's menu key, and
         the first pad's menu button when a pad is connected), so the text here is only what
         shows if the shell never gets to write it. -->
    <div class="toast" id="toast">
        <div class="mark"></div>
        <div class="tx">
            <div class="lead" id="hint-lead">F1 opens the menu</div>
            <div class="note" id="hint-note">Any time in play</div>
        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>HUD</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="hud-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">HUD</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">Up and down to move, left and right to change, Escape or the pad's B goes back</div>
            </div>

            <!-- THE GAME'S HUD, HOW IT FADES (the user, 2026-10-09: "auto-dim/auto-hide hud when not
                 in use ... dim at all times, or hide/dim hud on mapped key or button"). The rows are
                 the settings table's, picked out by key (is_hud_setting in ui_shell.cpp), each shown
                 only while it applies; src/game/hud.h has the rest. -->
            <div class="rows long" id="hud-rows"></div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="hud-foot">The HUD button is on the controls screen, Tab or the right stick's click by default</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Launch</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="frame">
        <div class="case window">

            <!-- The lid is the window's title bar: the mark and the title, then our own
                 minimize and close. The band is draggable (main/launch.cpp's hit test). -->
            <div class="lid">
                <div class="head">
                    <div class="mark"></div>
                    <div class="title">OoT: Recompiled</div>
                </div>
                <div class="chrome">
                    <div class="win-btn" id="win-min"><div class="glyph-min"></div></div>
                    <div class="win-btn" id="win-max"><div class="glyph-max"></div></div>
                    <div class="win-btn" id="win-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                </div>
            </div>

            <!-- THE ROWS ARE BUILT FROM THE MODEL, NOT LISTED HERE, exactly as the controls
                 document and the debug menu build theirs. This used to be a fixed run of row
                 elements, and on 2026-09-22 adding two settings pushed three rows off the end of
                 it: a row with no element simply does not appear, so Controls, Your files and
                 Debug vanished while the menu looked perfectly normal. Slots were added, and then
                 the user asked the better question ("but can we not just add scrollable areas?"),
                 which is this. There is now no number here to get wrong, and a list longer than
                 the case scrolls instead of being cut off. -->
            <div class="rows long" id="launch-rows"></div>

            <!-- Play and Quit are ACTIONS, not settings, and the user asked twice for them to
                 look like it: out of the list, under a divider, Quit on the left as a secondary
                 and Play on the right as the primary. They keep their place in the keyboard and
                 pad order; only where they are drawn has changed. -->
            <div class="actions">
                <div class="act-btn act-quit" id="act-quit"><span class="act-label" id="act-quit-label">Quit</span></div>
                <div class="act-btn act-play" id="act-play"><span class="act-label" id="act-play-label">Play</span></div>
            </div>

            <!-- ONE foot row (the user, 2026-09-20: "it's just a single row"). The key hints
                 on the left; the version and what Windows says of this program's own file
                 together on the right, as one clickable thing that opens About. The ROM blurb
                 that used to sit left of the hints is gone: the ROM row already says it. -->
            <div class="foot">
                <span id="launch-foot">F2 is about, F3 is controls</span>
                <span class="link" id="launch-signed">Not signed</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Letterbox</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <style>
        /* THE BARS OF A Z TARGET AND A CUTSCENE (2026-09-24; the user: "the black bar at top and
           bottom of screen animates in very very chappy rather than smooth when z targeting").
           The game makes them by scissoring the picture, and that scissor can only move once per
           game update; these are drawn over the picture instead and their height is set every
           frame the program presents, so they slide rather than step.

           No transition and no animation here on purpose: the easing is done in the program, in
           the game's own units and at the game's own speed, so the bars arrive exactly when the
           game believes they have. A transition on top would fight it. */
        body {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }
        .bar {
            position: absolute;
            left: 0;
            width: 100%;
            height: 0px;
            background-color: #000000ff;
        }
        .bar.top { top: 0; }
        .bar.bottom { bottom: 0; }
    </style>
</head>
<body>
    <div class="bar top" id="letterbox-top"></div>
    <div class="bar bottom" id="letterbox-bottom"></div>
</body>
</rml>
<rml>
<head>
    <title>Lighting</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="lighting-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Lighting</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">Every change shows at once. Up and down to move, left and right to change, Escape or the pad's B goes back</div>
            </div>

            <!-- Built from the lighting model (ui_lighting.cpp), the way the settings rows are: one
                 row per control, each with an Off where off makes sense and a scale of levels, and
                 a Reset row at the end that puts the design's values back. -->
            <div class="rows long" id="lighting-rows"></div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="lighting-foot">Each part switches on its own; Inspect shows one pass instead of the picture</span>
            </div>

        </div>
    </div>
</body>
</rml>
/* The mark: three stacked triangles, ours, in the decision's brass, with the gleam crossing them
 * every few seconds exactly as the decision's snapshots draw it. It is drawn by the mark's pixel
 * shader (src/ui/shaders/ui.hlsl, PSMark) through RmlUi's shader decorator, because the shape is
 * a mask over a sliding gradient and the renderer draws masks in a shader or not at all. The box
 * is sized here; the shader fits and centers the mark inside it. Tokens only, as every component
 * sheet.
 *
 * Markup, in every lid and in the hint:
 *
 *     <div class="mark"></div>
 */

.mark
{
	width: var(--mark-w);
	height: var(--mark-h);
	decorator: shader(mark);
}
<rml>
<head>
    <title>Moments</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Moments</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">Up and down to choose, Enter takes you to the buttons, left and right between them, Escape or the pad's B goes back</div>
            </div>

            <!-- Nine slots: the autosave's, then eight of the player's. Built by the shell from the
                 slot files at the moment the screen opens (phase 77, .scaffold/states/): a thumbnail
                 where one exists, the name, the scene and the time. An empty slot says so and offers
                 itself. -->
            <div class="rows long" id="moment-rows"></div>

            <!-- Save here writes the focused slot (in play only; the launcher offers Resume alone),
                 Resume loads it, Delete removes it. Nothing here is one click from losing progress:
                 Delete asks twice, the same way Remove everything does. Two to a row (case.rcss,
                 .pairs), so none of the four is crushed in the panel. -->
            <div class="actions pairs">
                <div class="act-btn act-quit" id="moments-delete"><span class="act-label" id="moments-delete-label">Delete</span></div>
                <div class="act-btn act-quit" id="moments-save"><span class="act-label" id="moments-save-label">Save here</span></div>
                <div class="act-btn act-play" id="moments-load"><span class="act-label" id="moments-load-label">Load</span></div>
                <div class="act-btn" id="moments-cancel"><span class="act-label">Cancel</span></div>
            </div>

            <!-- THE ONE LINE OF HONESTY, always shown (states-design.md section 8). -->
            <div class="foot">
                <span id="moments-note">A moment keeps your progress and where you stand. Enemies, platforms and effects start over, as when the game loads a file. Rewind is not offered: the program cannot freeze the game mid frame.</span>
            </div>

        </div>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Recorder</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
</head>
<body class="overlay">
    <!-- The frame recorder's plate (the user's ask of 2026-09-22): "an overlay element that sits
         it top left just like the fps does in top right". The same plate as the frame rate
         counter, in the opposite corner. Unlike the counter it does NOT move when the title bar
         appears; case.rcss says why, and the short version is that a button which slides out from
         under the pointer aiming at it is not a button.

         THE WHOLE PLATE IS THE BUTTON. One click starts a recording of the length the settings
         row holds, and one more ends it early. The dot is what says which of those a click will
         do, so the state is readable at a glance from across the room rather than needing the
         words to be read. -->
    <div class="counter recorder" id="recorder">
        <div class="mark"></div>
        <span class="counter-value" id="record-text">Record</span>
        <!-- THE DOT IS A DIVIDER AS WELL AS A STATE (the user's ask of 2026-09-23). It sat
             between the mark and the word, where it read as a second mark and left `Record` and
             `0:05` touching each other with nothing between them. Between the two it separates
             them and still carries the color that says whether a click starts or stops. -->
        <span class="dot" id="record-dot"></span>
        <span class="counter-unit" id="record-note"></span>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim" id="settings-scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Settings</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <div class="hint">Up and down to move, left and right to change, Escape or the pad's B closes</div>
            </div>

            <!-- THE ROWS ARE BUILT FROM THE MODEL, NOT LISTED HERE, exactly as the controls
                 document and the debug menu build theirs. This used to be a fixed run of row
                 elements, and on 2026-09-22 adding two settings pushed three rows off the end of
                 it: a row with no element simply does not appear, so Controls, Your files and
                 Debug vanished while the menu looked perfectly normal. Slots were added, and then
                 the user asked the better question ("but can we not just add scrollable areas?"),
                 which is this. There is now no number here to get wrong, and a list longer than
                 the case scrolls instead of being cut off. -->
            <div class="rows long" id="settings-rows"></div>

            <!-- Quit is an ACTION, drawn in the same bar the launcher uses, alone: there is
                 nothing to Play from inside the game. It was missing here altogether once the two
                 buttons left the list (the user, 2026-09-23), and with the title bar off this
                 menu is the only way out of the program. It keeps its place at the end of the
                 keyboard and pad order. -->
            <div class="actions">
                <div class="act-btn act-quit" id="act-quit"><span class="act-label" id="act-quit-label">Quit</span></div>
            </div>

            <div class="foot">
                <span>Saved as you change it</span>
                <span id="settings-foot">F1 closes this, F2 is about, F3 is controls</span>
            </div>

        </div>
    </div>
</body>
</rml>
/* Design tokens. Every value our interface uses lives here and nowhere else.
 *
 * These come from the finalized design decision 9693d652-0b2a-43e6-ae79-09ea2382cad3, direction A,
 * "Instrument Case": a walnut dark case lit from one warm source at the top left, hardware doing
 * the dividing, and the focused row catching the lamplight the way metal actually would.
 *
 * NO COMPONENT STYLESHEET MAY CONTAIN A LITERAL COLOR, SIZE, SPACING, RADIUS OR DURATION. If a
 * value is needed and is not here, it gets a token here first. That rule is what makes the whole
 * palette a one file edit, which is the thing the decision was chosen on the strength of.
 *
 * Names describe MATERIAL AND ROLE, never the game. Nothing in this interface is named after
 * anything in the ROM, and nothing in it is drawn from anything in the ROM.
 */

@spritesheet case-hardware
{
	/* Reserved. Our own drawn hardware goes here when it exists; until then the case is built
	 * from borders and gradients, which is honest rather than a placeholder image. */
}

body
{
	/* Type.
	 *
	 * ONE FAMILY PER TOKEN, no stack. RCSS custom properties do not take a comma separated list,
	 * and a declaration containing one is rejected outright: the variable then does not exist, and
	 * every rule that referenced it falls back to nothing. That failed silently apart from one
	 * warning buried in the log.
	 *
	 * The fallback ordering the decision describes is done by LOADING instead: the shell tries our
	 * own faces first and only registers the system ones if none are present. So these three names
	 * are the ones that are actually registered, and dropping licensed faces into assets/fonts
	 * means changing these three lines to their family names. */
	--font-display: Georgia;
	--font-body: Segoe UI;
	--font-mono: Consolas;

	--size-title: 21dp;
	--size-heading: 16dp;
	--size-row: 15dp;
	--size-note: 13dp;
	--size-caption: 12dp;

	--weight-display: 600;
	--weight-body: 400;

	/* Ground. The case WAS translucent, so the scene behind it read through (the pinned
	 * comment on the decision asked for it, borrowed from the lantern direction). On
	 * 2026-09-19 the user, reading About over the launcher, found the rows behind it made the
	 * text hard to read and asked for a blur or a solid background; a backdrop blur needs
	 * layer and filter support in the render backend, which is not here yet, so the case is
	 * solid: the same three colors at full alpha. The scrim still dims what is behind. */
	--case-top: rgba(58, 44, 32, 255);
	--case-mid: rgba(43, 32, 23, 255);
	--case-bottom: rgba(36, 26, 19, 255);
	--case-raise: #42332a;
	--scrim: rgba(12, 9, 6, 150);

	/* Ink */
	--text: #f2e7d5;
	--text-dim: #b39a78;
	--text-faint: #ab9476;
	--on-accent: #241a13;

	/* Brass. One accent, used for the one moment: the focused row's lit edge. */
	--accent: #cfa33c;
	--accent-soft: rgba(207, 163, 60, 60);

	/* Hardware */
	--line: #5d472f;
	--line-bright: #8a6a36;
	--track: #1c150f;
	--row-on: rgba(70, 54, 34, 128);

	/* Judgment colors, kept apart from the accent so they never compete with it */
	--ok: #9fb46a;
	--bad: #cd7a5a;

	/* Metrics */
	--radius: 4dp;
	--radius-tight: 2dp;
	--pad: 17dp;
	--pad-row: 8dp;
	--pad-row-side: 11dp;
	--gap: 1dp;
	--rule: 1dp;
	--edge: 3dp;

	--case-width: 620dp;
	--case-max-height: 78%;

	/* The controls document (phase 50): a binding slot's width, so the two slots of every row
	 * line up down the list; the list's scrollbar; the capture panel's width. The toast (the
	 * startup hint) follows the decision's toast surface: its width, its inner spacing and the
	 * brass mark beside the text. */
	--slot-width: 150dp;
	--scroll: 6dp;
	--capture-width: 360dp;
	--toast-width: 330dp;
	--pad-toast: 12dp;

	/* The action bar under the launcher's list: Play and Quit as real buttons, and the destructive
	   button on the files surface. Their height and their side padding, so the three read as one
	   family and a fourth cannot drift. */
	--act-height: 40dp;
	--pad-act-side: 22dp;

	/* A step chevron's hit width: wide enough for a pointer to land on without aiming at the
	   glyph (the user, 2026-09-24: the side arrows did not take clicks). */
	--step-width: 30dp;
	/* A box to tick (the HUD menu's Comes back for, 2026-10-09): its side, and the filled square
	 * inside it, inset from its edge, while it is ticked. */
	--check: 14dp;
	--check-inset: 3dp;
	--check-tick: 8dp;
	/* A divider's small name inside a list, spaced out (2026-10-09), and how far a badge under a
	 * control's name sits below it (the controls screen, 2026-10-09). */
	--divider-tracking: 1dp;
	--badge-drop: 3dp;

	/* A setting's value sits in a box of ONE width whatever it reads, so the step chevrons either
	   side of it hold still while a row is stepped rather than sliding under the pointer. Wide
	   enough for the longest option text in the table ("Expand to the window"). */
	--value-width: 140dp;

	/* The label column on the files surface, wide enough for its longest label ("Your copy of
	   the game") so every path on that screen starts at the same x. */
	--files-label-width: 160dp;

	/* The mark: our three stacked triangles in the decision's brass (the panel header's mark,
	 * .p-h h4::before in its snapshots, a masked gradient with a gleam crossing it every five
	 * seconds), drawn by the mark's pixel shader through the shader decorator (mark.rcss). The
	 * box here has the mark's own proportions (24 by 20); the brass quartet below is the
	 * shader's palette, repeated in ui.hlsl under these names because a shader cannot read a
	 * stylesheet, and tools/make_icon.py cuts the window's icon from the same four. */
	--brass: #b8912f;
	--brass-light: #e8cd7e;
	--brass-peak: #fff7d8;
	--brass-deep: #a8801f;
	--mark-w: 18dp;
	--mark-h: 15dp;

	/* The window chrome (window.rcss): the minimize, maximize and close buttons, and the glyphs
	 * inside them. ONE SIZE, USED BY BOTH BARS, the launcher's lid and the game window's own
	 * title bar. The band the window is dragged by is the lid, whose height main/launch.cpp
	 * repeats in pixels for the hit test.
	 *
	 * The launcher's used to be 32dp against the game's 22dp, and every attempt to make the two
	 * agree while keeping them different sizes moved the fault from one surface to the other
	 * rather than fixing it. 22dp is the game bar's, which is the one the user judged correct:
	 * "make them both the same exact size as the now in-game window bar". */
	--win-btn: 22dp;
	--glyph-w: 10dp;
	/* Where a close cross's bar sits inside its box, and the one token here that is DERIVED from
	 * two others rather than chosen: (--glyph-w minus --rule) / 2, which is (10 - 1) / 2. RCSS has
	 * no arithmetic, so the sum is done here and has to be redone by hand if either of those two
	 * changes.
	 *
	 * It is a token rather than the literal it used to be in window.rcss because tools/
	 * check_tokens.py is right that a bare 4.5dp in a component stylesheet is unreadable: the
	 * number means nothing without the two it comes from, and putting it next to them is the only
	 * place the relationship is visible. window.rcss keeps the paragraph on WHY the half pixel
	 * matters, which is about rasterization rather than about the palette. */
	--glyph-bar-top: 4.5dp;
	/* The game window's title bar (frame.rml): a regular title bar's height, with a smaller
	 * mark and smaller buttons than the launcher's lid. */
	--chrome-bar: 30dp;
	/* A corner plate's top while the title bar shows: the bar's height plus the side gap it
	 * keeps from the window edge (30 plus 11), so it stands off the bar by the same distance;
	 * with the bar hidden it sits that gap from the window's top edge instead.
	 *
	 * SHARED BY BOTH PLATES, which is why it is not called the counter's: the frame rate counter
	 * at the top right and the frame recorder at the top left are the same piece of hardware in
	 * opposite corners, and they must move together when the bar appears. It was named after the
	 * counter when the counter was the only one. */
	--plate-top-under-bar: 41dp;

	/* The frame recorder (the user's ask of 2026-09-22). Its own red, because "recording" is a
	 * state and not a fault: --bad is the color of something being wrong and would read as an
	 * error sitting in the corner of the picture. Kept apart from the accent for the same reason
	 * the other judgment colors are, so nothing competes with the focused row's lit edge.
	 * --record-idle is the dot before anything is happening, which is the same hardware unlit. */
	--record: #d0533f;
	--record-idle: #6b5640;
	--dot: 9dp;
	/* There is deliberately NO --win-btn-small and NO --glyph-small. Both bars draw the same
	 * controls at the same size now, and the two tokens that used to shrink the game's (22dp
	 * buttons and 8dp glyphs) are gone rather than kept "in case".
	 *
	 * Each of them caused a defect the user reported. The smaller GLYPH broke the close cross
	 * outright: it is two one pixel bars rotated forty five degrees, and at eight device pixels
	 * they stopped meeting (window.rcss says how). The smaller BUTTON, left behind when the
	 * glyphs were matched, made the launcher's controls read as small and widely spaced. A token
	 * left lying about invites both mistakes back. */
	--mark-small-w: 14dp;
	--mark-small-h: 12dp;

	/* Motion. Nothing over the game may be slow: an interface that lingers on top of a live
	 * scene reads as lag rather than as polish. */
	--duration-fast: 0.10s;
	--duration-slow: 0.18s;
}
<rml>
<head>
    <title>Update</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
</head>
<body class="overlay">
    <!-- The update plate (the user's ask of 2026-09-23: "it must show an overlay that an update
         is available, it can download in bg and say to the user the new update will install next
         restart"). The counter's plate, at the BOTTOM left so it sits under neither corner plate
         and never under the title bar. It appears only while there is something to say: the newer
         version being fetched, the fetched file verified and waiting for the next start, or a
         download that failed verification and was deleted. A click while the file is ready
         installs it now and closes this copy, which is what F5 does. -->
    <div class="counter update" id="update">
        <div class="mark"></div>
        <span class="counter-value" id="update-value">Update</span>
        <span class="counter-unit" id="update-note"></span>
    </div>
</body>
</rml>
<rml>
<head>
    <title>Debug</title>
    <link type="text/rcss" href="tokens.rcss"/>
    <link type="text/rcss" href="case.rcss"/>
    <link type="text/rcss" href="controls.rcss"/>
    <link type="text/rcss" href="mark.rcss"/>
    <link type="text/rcss" href="window.rcss"/>
</head>
<body>
    <div class="scrim">
        <div class="case">

            <div class="lid stacked">
                <div class="lid-top">
                    <div class="head">
                        <div class="mark"></div>
                        <div class="title">Debug</div>
                    </div>
                    <div class="chrome">
                        <div class="win-btn" id="modal-close"><div class="glyph-x"><div class="bar a"></div><div class="bar b"></div></div></div>
                    </div>
                </div>
                <!-- Where in the nesting you are: empty at the top, then the region, then the
                     region and the place. The shell fills it every time the level changes. -->
                <div class="hint" id="warp-trail"></div>
                <div class="hint">Up and down to move, Enter goes in or warps, Escape or the pad's B goes back</div>
            </div>

            <!-- Built at runtime from src/ui/ui_warps.cpp, the same way the controls list is:
                 the document holds no names of its own, so the order on screen is the order in
                 the generated table and nothing here can drift away from it. -->
            <div class="rows long" id="warp-rows"></div>

            <div class="foot">
                <span id="warp-note"></span>
                <span id="warp-foot"></span>
            </div>

        </div>
    </div>
</body>
</rml>
/* The launcher as its own window (play milestone): the case IS the window, edge to edge, with
 * our own chrome in its lid: the mark and the title at the left, minimize and close at the
 * right. The window itself is borderless (main/launch.cpp shapes it and makes the lid's band
 * draggable), so everything the user sees is drawn here in the case's own tokens. Tokens only,
 * as every component sheet.
 */

.frame
{
	width: 100%;
	height: 100%;
}

.case.window
{
	width: 100%;
	height: 100%;
	max-height: 100%;
	border-radius: 0;
	border-color: var(--accent);
}

/* The game window's frame (frame.rml): the same brass edge around the window, and the header
 * as a bar across the top, the launcher's lid riding over the picture while the pointer is
 * there. Both are hidden by the shell the rest of the time. */
.frame-edge
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: 100%;
	border: var(--rule) var(--accent);
	box-sizing: border-box;
}

.frame-bar
{
	position: absolute;
	left: 0;
	top: 0;
	width: 100%;
	height: var(--chrome-bar);
	box-sizing: border-box;
	padding: 0 var(--pad-row-side);
	display: flex;
	align-items: center;
	justify-content: space-between;
	decorator: gradient(vertical var(--case-top) var(--case-bottom));
	border-bottom: var(--rule) var(--accent);
}

/* A title bar's proportions: the title in the caption size, the mark smaller than the launcher's
 * lid. THE BUTTONS ARE NOT LISTED HERE ANY MORE and that is the point: they are one size, defined
 * once in tokens.rcss, and both bars use it.
 *
 * They used to differ, 32dp in the launcher against 22dp here, and the difference outlived the
 * reason for it. Matching only the GLYPHS (the fix before this one) left a 10dp glyph sitting in
 * a 32dp button in the launcher and a 22dp one in the game, so the launcher's controls read as
 * small and widely spaced: "you essentially reversed the issue. the launcher pre-game now has
 * the problem". The user's instruction settles which one wins: "make them both the same exact
 * size as the now in-game window bar". */
.frame-bar .title
{
	font-size: var(--size-caption);
}

.frame-bar .mark
{
	width: var(--mark-small-w);
	height: var(--mark-small-h);
	margin-right: var(--pad-row);
}

/* THE GLYPHS ARE THE SAME SIZE IN BOTH BARS. Only the button they sit in is smaller here, so the
 * bar over the picture stays slim.
 *
 * They used to be shrunk too, to --glyph-small (8dp against 10dp), and the close glyph came out
 * BROKEN rather than small: it is two one-pixel bars rotated forty five degrees about their own
 * centers, and at eight device pixels the two land on different fractional pixels and stop
 * meeting, so the cross renders as a slash with a stub beside it. The user saw it straight away
 * ("this close button in the game window bar doesn't look correct like the launcher") and a
 * magnified capture of the two bars side by side shows it plainly: clean cross above, broken one
 * below. The minimize and maximize glyphs survived the shrink because a horizontal rule and a
 * square border have no diagonal to round.
 *
 * So the fix is not to nudge the rotated bars into alignment at one particular size, which would
 * break again at the next one. Ten device pixels is what the launcher already draws correctly and
 * it fits comfortably inside the smaller 22dp button. One glyph size, used twice. */

.frame-edge.hidden,
.frame-bar.hidden
{
	display: none;
}

.chrome
{
	display: flex;
	align-items: center;
}

.win-btn
{
	width: var(--win-btn);
	height: var(--win-btn);
	margin-left: var(--gap);
	display: flex;
	align-items: center;
	justify-content: center;
	font-family: var(--font-display);
	font-size: var(--size-heading);
	color: var(--text-dim);
	border-radius: var(--radius-tight);
	transition: background-color var(--duration-fast) linear-in-out,
	            color var(--duration-fast) linear-in-out;
}

.win-btn:hover
{
	color: var(--text);
	background-color: var(--row-on);
}

/* The minimize glyph: a short bar, drawn rather than typed. */
.glyph-min
{
	width: var(--glyph-w);
	height: var(--rule);
	background-color: var(--text-dim);
}

.win-btn:hover .glyph-min
{
	background-color: var(--text);
}

/* The maximize glyph: a square, drawn from a border. */
.glyph-max
{
	width: var(--glyph-w);
	height: var(--glyph-w);
	border: var(--rule) var(--text-dim);
	box-sizing: border-box;
}

.win-btn:hover .glyph-max
{
	border-color: var(--text);
}

/* The close glyph: two bars crossed, drawn rather than typed (a typed character was dropped by
 * the parser, and an icon is drawn in any case). */
.glyph-x
{
	position: relative;
	width: var(--glyph-w);
	height: var(--glyph-w);
}

.glyph-x .bar
{
	position: absolute;
	left: 0;
	/* HALF A PIXEL MATTERS HERE. `top: 50%` puts a one pixel bar's TOP at the box's center, so
	 * its own center, which is what it rotates about, sits half a pixel below the box's. The two
	 * bars then rasterize differently from each other depending on where the box lands on screen:
	 * clean in the launcher's bar, lopsided in the game's, with one arm longer than the other and
	 * the crossing off center. Offsetting by half the bar's thickness puts the rotation center on
	 * the box's center, where both directions round the same way. The number is (--glyph-w minus
	 * --rule) / 2, done by hand in tokens.rcss because RCSS has no arithmetic; change either of
	 * those two and --glyph-bar-top has to be redone with them. */
	top: var(--glyph-bar-top);
	width: var(--glyph-w);
	height: var(--rule);
	background-color: var(--text-dim);
}

.glyph-x .bar.a
{
	transform: rotate(45deg);
}

.glyph-x .bar.b
{
	transform: rotate(-45deg);
}

.win-btn:hover .glyph-x .bar
{
	background-color: var(--text);
}
